#!/bin/sh
# LM Studio in an AI workspace, at every start (the template's startup script runs it in the background): ~/.lmstudio
# linked to the image's app (coder-lmstudio-home), the models (coder-ai-models), the app on the workspace's desktop
# (display :1, the Desktop app), then - once it answers - its server on 127.0.0.1:1234 (OpenAI-compatible; models
# load when first asked for, at the default context length) and OpenCode's settings (coder-opencode-config).
# Safe to run again (an LM Studio already running is kept).
#   coder-lmstudio-start [CONTEXT]
set -u
CONTEXT="${1:-32768}"
coder-lmstudio-home "$CONTEXT"
coder-ai-models
export DISPLAY="${DISPLAY:-:1}" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	export XDG_RUNTIME_DIR="/tmp/runtime-$(id -un)"
	mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
fi
if ! pgrep -u "$(id -u)" -x lm-studio >/dev/null; then
	if [ ! -S "/tmp/.X11-unix/X${DISPLAY#:}" ]; then
		echo "LM Studio: no desktop on display $DISPLAY (an image without one): not started"
		exit 1
	fi
	setsid /usr/local/bin/lm-studio </dev/null >/tmp/lm-studio.log 2>&1 &
	echo "LM Studio: started on the desktop (log: /tmp/lm-studio.log)"
fi
i=0
until lms ls --json >/dev/null 2>&1; do
	i=$((i + 1))
	if [ "$i" -ge 90 ]; then
		echo "LM Studio did not answer in 3 minutes (log: /tmp/lm-studio.log)"
		exit 1
	fi
	sleep 2
done
lms server start --port 1234 --bind 127.0.0.1 2>&1 | tail -n 1
coder-opencode-config "$CONTEXT"
