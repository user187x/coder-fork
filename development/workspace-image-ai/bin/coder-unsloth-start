#!/bin/sh
# Unsloth Studio in an AI workspace, at every start (the template's startup script runs it in the background):
# ~/.unsloth linked to the image's install (coder-unsloth-home), then the app on the workspace's desktop (display :1,
# the Desktop app) - it starts Unsloth's server on 127.0.0.1:8888 (its OpenAI-compatible API at /v1) - and waits until
# the server answers. Safe to run again (an app already running is kept).
#   coder-unsloth-start
set -u
coder-unsloth-home
export DISPLAY="${DISPLAY:-:1}" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	XDG_RUNTIME_DIR="/tmp/runtime-$(id -un)"
	export XDG_RUNTIME_DIR
	mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
fi
if ! pgrep -u "$(id -u)" -x unsloth-studio >/dev/null; then
	if [ ! -S "/tmp/.X11-unix/X${DISPLAY#:}" ]; then
		echo "Unsloth: no desktop on display $DISPLAY (an image without one): not started"
		exit 1
	fi
	(cd "$HOME" && setsid /usr/local/bin/unsloth-studio-app </dev/null >/tmp/unsloth-studio.log 2>&1 &)
	echo "Unsloth: started on the desktop (log: /tmp/unsloth-studio.log)"
fi
i=0
until curl -fs -m 2 http://127.0.0.1:8888/api/health >/dev/null 2>&1; do
	i=$((i + 1))
	if [ "$i" -ge 90 ]; then
		echo "Unsloth's server did not answer in 3 minutes (log: /tmp/unsloth-studio.log)"
		exit 1
	fi
	sleep 2
done
echo "Unsloth: its server answers on 127.0.0.1:8888"
