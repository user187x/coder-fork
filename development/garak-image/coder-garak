# ------------------------------------------------------------------------------------------------ posting back
def post(url, body, content_type="application/json", tries=8):
    data = body if isinstance(body, bytes) else json.dumps(body).encode()
    for n in range(tries):
        try:
            req = urllib.request.Request(url, data=data, method="POST", headers={"Content-Type": content_type})
            with urllib.request.urlopen(req, timeout=120) as r:
                return r.status
        except urllib.error.HTTPError as e:
            if e.code < 500 or n == tries - 1:
                log("post %s: HTTP %s" % (url.split("?")[0].rsplit("/", 1)[-1], e.code))
                return e.code
        except OSError as e:
            if n == tries - 1:
                log("post failed:", e)
                return 0
        time.sleep(min(30, 2 ** n))


