# coder-platform installation answers. Copy to install.conf, fill in, then run: ./install all
# Every value here is also an environment variable (the environment wins), so a CI job can skip this file.
# Secrets (OIDC client secret, registry password) are NOT kept here: ./install asks for them once and stores them
# as Kubernetes Secrets (or read them from OIDC_CLIENT_SECRET / REGISTRY_PASSWORD in the environment).

# ---- required -------------------------------------------------------------------------------------------------
# Coder is https://coder.<DOMAIN>; workspace apps use *.<DOMAIN> (wildcard DNS + a certificate covering both).
DOMAIN=corp.example.com
# Where ./install images pushes the images, and where the cluster pulls them from (registry host + optional path).
REGISTRY=registry.corp.example.com/coder-platform
# Keycloak realm URL (Coder's OIDC issuer). Its client "coder" must allow https://coder.<DOMAIN>/api/v2/users/oidc/callback.
OIDC_ISSUER_URL=https://keycloak.corp.example.com/realms/master
# People who become Coder owners when they first sign in with Keycloak: "username:email" separated by spaces.
# The email must be the one Keycloak sends for them.
ADMINS="jdoe:jdoe@corp.example.com"

# ---- usually fine as they are ---------------------------------------------------------------------------------
NAMESPACE=coder                 # Coder, its database and the workspaces
RELEASE=coder-platform          # Helm release / Argo CD Application name
OIDC_CLIENT_ID=coder
# PEM file of the private CA that signed the Traefik certificate (and Keycloak's). Empty = public CA, nothing to trust.
CA_FILE=./ca.crt
OIDC_CA_FILE=                   # only if Keycloak's certificate comes from a different CA than CA_FILE
# Only members of these Keycloak groups may sign in (space-separated; empty = no restriction). Nested groups are sent
# as full paths when the client's Group Membership mapper has "Full group path" on: /KeycloakGroup/Admin
OIDC_GROUP_FIELD=               # the token claim with the groups, e.g. groups
OIDC_ALLOWED_GROUPS=            # e.g. "/KeycloakGroup/Admin /KeycloakGroup/Developers"
# Traefik and its Gateway. GATEWAY_SECTION empty = the Gateway's HTTPS listener, found automatically.
TRAEFIK_NAMESPACE=traefik
GATEWAY_NAME=traefik-gateway
GATEWAY_NAMESPACE=traefik
GATEWAY_SECTION=
STORAGE_CLASS=                  # empty = the cluster's default StorageClass
# Registry login for pulls, if the registry isn't anonymous: ./install creates a docker-registry Secret from it.
REGISTRY_USERNAME=
REGISTRY_INSECURE=false         # true for a registry on plain HTTP (the nodes' container runtime must allow it too)
# CloudNativePG operator: auto = install it unless the cluster already runs one (then the existing one is used).
CNPG=auto
# Namespace of an operator-managed Keycloak (enables automatic discovery in General > Keycloak). Optional.
KEYCLOAK_NAMESPACE=
# IP of Traefik's load balancer: ./install verify connects there instead of DNS (check before switching DNS over).
CODER_ADDRESS=

# ---- deployment method ----------------------------------------------------------------------------------------
# helm   = helm upgrade --install from this bundle
# argocd = push the chart to oci://<REGISTRY>/charts and write/apply an Argo CD Application for it
DEPLOY=helm
ARGOCD_NAMESPACE=argocd
ARGOCD_PROJECT=default          # the Argo CD project the Application goes into (it must allow what the chart creates)
