#!/usr/bin/env bash
# coder-platform installer for air-gapped (and connected) Kubernetes clusters.
#
#   ./install all          preflight, images, secrets, plugin, deploy, verify, in that order (stops at the first problem)
#   ./install preflight    check the cluster and install.conf; changes nothing
#   ./install images       push the bundled images to $REGISTRY
#   ./install secrets      create the Secrets Coder needs (CA, OIDC client secret, registry login) if missing
#   ./install plugin       enable Traefik's rewrite-body plugin (offline copy) if it isn't loaded
#   ./install values       write generated/values.yaml from install.conf and print it; changes nothing
#   ./install deploy       helm upgrade --install (DEPLOY=helm) or push the chart + apply an Argo CD Application
#   ./install verify       check the running installation end to end (through the Gateway, like a browser)
#   ./install status       what is running, the bootstrap Job's log, where the admin password is
#   ./install argocd-repo  (re)register the registry's charts in Argo CD (e.g. renew a 12-hour ECR login)
#
# Options: --config <file> (default ./install.conf), --yes (no questions: fail instead of prompting),
#          --force (secrets: replace existing Secrets whose content differs).
# Every step can be re-run; nothing that already exists is overwritten without --force.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
CONFIG="${HERE}/install.conf"; ASSUME_YES=0; FORCE=0; ACTION=""
while [[ $# -gt 0 ]]; do
 case "$1" in
  --config) CONFIG=$(realpath "$2"); shift 2 ;;
  --yes|-y) ASSUME_YES=1; shift ;;
  --force) FORCE=1; shift ;;
  -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
  -*) echo "unknown option $1" >&2; exit 2 ;;
  *) [[ -z "${ACTION}" ]] || { echo "one action at a time" >&2; exit 2; }; ACTION="$1"; shift ;;
 esac
done
ACTION="${ACTION:-help}"
[[ "${ACTION}" == help ]] && { sed -n '2,17p' "$0"; exit 0; }

# ------------------------------------------------------------------------------------------------ output helpers
if [[ -t 1 ]]; then B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'; else B=""; G=""; Y=""; R=""; N=""; fi
step() { echo; echo "${B}== $*${N}"; }
ok()   { echo "  ${G}OK${N}    $*"; }
warn() { echo "  ${Y}WARN${N}  $*"; WARNINGS=$((WARNINGS + 1)); }
bad()  { echo "  ${R}FAIL${N}  $*"; FAILURES=$((FAILURES + 1)); }
die()  { echo "${R}error:${N} $*" >&2; exit 1; }
WARNINGS=0; FAILURES=0

# ------------------------------------------------------------------------------------------------ configuration
# install.conf is KEY=value lines; the environment overrides it.
declare -A FROM_ENV=()
for k in DOMAIN REGISTRY OIDC_ISSUER_URL ADMINS NAMESPACE RELEASE OIDC_CLIENT_ID CA_FILE OIDC_CA_FILE TRAEFIK_NAMESPACE \
         GATEWAY_NAME GATEWAY_NAMESPACE GATEWAY_SECTION STORAGE_CLASS REGISTRY_USERNAME CNPG KEYCLOAK_NAMESPACE DEPLOY \
         ARGOCD_NAMESPACE ARGOCD_PROJECT OIDC_ENABLED REGISTRY_INSECURE CODER_ADDRESS ARGOCD_CONTEXT ARGOCD_DEST_SERVER \
         ATTACH CODER_SERVICE CODER_DEPLOYMENT POSTGRES_NAME CODER_DB_SECRET CODER_DB_SECRET_KEY CODER_DB_CA_SECRET \
         WORKSPACE_NAMESPACE TEMPLATE_NAME TEMPLATE_ENABLED AWS_REGION OIDC_SECRET_NAME OIDC_GROUP_FIELD OIDC_ALLOWED_GROUPS; do
 [[ -n "${!k+x}" ]] && FROM_ENV[$k]="${!k}"
done
if [[ -f "${CONFIG}" ]]; then
 # shellcheck disable=SC1090
 set -a; . "${CONFIG}"; set +a
elif [[ "${ACTION}" != status ]]; then
 die "no ${CONFIG}: copy install.conf.example to install.conf and fill it in (or pass --config <file>)"
fi
for k in "${!FROM_ENV[@]}"; do printf -v "$k" '%s' "${FROM_ENV[$k]}"; done
NAMESPACE="${NAMESPACE:-coder}"; RELEASE="${RELEASE:-coder-platform}"; OIDC_CLIENT_ID="${OIDC_CLIENT_ID:-coder}"
TRAEFIK_NAMESPACE="${TRAEFIK_NAMESPACE:-traefik}"; GATEWAY_NAME="${GATEWAY_NAME:-traefik-gateway}"
GATEWAY_NAMESPACE="${GATEWAY_NAMESPACE:-traefik}"; GATEWAY_SECTION="${GATEWAY_SECTION:-}"; STORAGE_CLASS="${STORAGE_CLASS:-}"
CNPG="${CNPG:-auto}"; DEPLOY="${DEPLOY:-helm}"; ARGOCD_NAMESPACE="${ARGOCD_NAMESPACE:-argocd}"; ARGOCD_PROJECT="${ARGOCD_PROJECT:-default}"; KEYCLOAK_NAMESPACE="${KEYCLOAK_NAMESPACE:-}"
CA_FILE="${CA_FILE:-}"; OIDC_CA_FILE="${OIDC_CA_FILE:-}"; REGISTRY_USERNAME="${REGISTRY_USERNAME:-}"; ADMINS="${ADMINS:-}"
OIDC_ENABLED="${OIDC_ENABLED:-true}"; REGISTRY_INSECURE="${REGISTRY_INSECURE:-false}"; CODER_ADDRESS="${CODER_ADDRESS:-}"; DOMAIN="${DOMAIN:-}"; REGISTRY="${REGISTRY%/}"; OIDC_ISSUER_URL="${OIDC_ISSUER_URL:-}"
# Relative CA paths are relative to the config file.
cfgdir=$(dirname "${CONFIG}")
[[ -n "${CA_FILE}" && "${CA_FILE}" != /* ]] && CA_FILE="${cfgdir}/${CA_FILE}"
[[ -n "${OIDC_CA_FILE}" && "${OIDC_CA_FILE}" != /* ]] && OIDC_CA_FILE="${cfgdir}/${OIDC_CA_FILE}"
CODER_HOST="coder.${DOMAIN}"
# Existing Coder (./upgrade writes these): the chart attaches to it instead of installing Coder and its database.
ATTACH="${ATTACH:-false}"; CODER_SERVICE="${CODER_SERVICE:-coder}"; CODER_DEPLOYMENT="${CODER_DEPLOYMENT:-coder}"
POSTGRES_NAME="${POSTGRES_NAME:-coder-db}"; CODER_DB_SECRET="${CODER_DB_SECRET:-}"; CODER_DB_SECRET_KEY="${CODER_DB_SECRET_KEY:-uri}"
CODER_DB_CA_SECRET="${CODER_DB_CA_SECRET:-}"; WORKSPACE_NAMESPACE="${WORKSPACE_NAMESPACE:-}"
TEMPLATE_NAME="${TEMPLATE_NAME:-ubuntu-vnc-desktop}"; TEMPLATE_ENABLED="${TEMPLATE_ENABLED:-true}"
# Argo CD on another cluster (hub-and-spoke): its kube context, and this cluster's API URL as registered there.
ARGOCD_CONTEXT="${ARGOCD_CONTEXT:-}"; ARGOCD_DEST_SERVER="${ARGOCD_DEST_SERVER:-}"
# Amazon ECR: login with the AWS CLI (12-hour tokens), repositories created if missing, and no pull Secret (EKS nodes
# pull from ECR with their IAM role).
REGISTRY_HOST="${REGISTRY%%/*}"; REGISTRY_PATH=""; [[ "${REGISTRY}" == */* ]] && REGISTRY_PATH="${REGISTRY#*/}"
IS_ECR=false
if [[ "${REGISTRY_HOST}" =~ ^[0-9]{12}\.dkr\.ecr\.([a-z0-9-]+)\.amazonaws\.com(\.cn)?$ ]]; then IS_ECR=true; AWS_REGION="${AWS_REGION:-${BASH_REMATCH[1]}}"; fi
PULL_SECRET=""; [[ -n "${REGISTRY_USERNAME}" && "${IS_ECR}" != true ]] && PULL_SECRET="coder-platform-registry"
GEN="${HERE}/generated"
# DEPLOY=helm installs the CloudNativePG operator as its own release first: its CRDs and admission webhook must be
# running before the chart's database can be created, which one `helm install` can't order (Argo CD's sync waves can,
# so DEPLOY=argocd keeps the operator inside the chart).
CNPG_RELEASE=cnpg

# Bundle contents (see ../build-bundle).
CHART=$(ls "${HERE}"/charts/coder-platform-*.tgz 2>/dev/null | head -n1 || true)
CNPG_CHART=$(ls "${HERE}"/charts/cloudnative-pg-*.tgz 2>/dev/null | head -n1 || true)
IMAGES_LIST="${HERE}/images/images.txt"
BUNDLE_VERSION=$(cat "${HERE}/VERSION" 2>/dev/null || echo dev)

validate_config() {
 local errors=()
 [[ "${DOMAIN}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] || errors+=("DOMAIN '${DOMAIN}' is not a DNS domain (e.g. corp.example.com)")
 [[ "${REGISTRY}" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?(/[a-z0-9._/-]+)?$ ]] || errors+=("REGISTRY '${REGISTRY}' should look like registry.example.com[:port][/path]")
 [[ "${NAMESPACE}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || errors+=("NAMESPACE '${NAMESPACE}' is not a valid namespace")
 [[ "${RELEASE}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || errors+=("RELEASE '${RELEASE}' is not a valid release name")
 [[ "${DEPLOY}" == helm || "${DEPLOY}" == argocd ]] || errors+=("DEPLOY must be helm or argocd")
 [[ "${CNPG}" == auto || "${CNPG}" == install || "${CNPG}" == existing ]] || errors+=("CNPG must be auto, install or existing")
 if [[ "${OIDC_ENABLED}" == true ]]; then
  [[ "${OIDC_ISSUER_URL}" =~ ^https://[^/]+ ]] || errors+=("OIDC_ISSUER_URL must be https://<keycloak host>/realms/<realm>")
 fi
 [[ -z "${CA_FILE}" || -f "${CA_FILE}" ]] || errors+=("CA_FILE ${CA_FILE} does not exist")
 [[ -z "${OIDC_CA_FILE}" || -f "${OIDC_CA_FILE}" ]] || errors+=("OIDC_CA_FILE ${OIDC_CA_FILE} does not exist")
 [[ -z "${CA_FILE}" ]] || grep -q "BEGIN CERTIFICATE" "${CA_FILE}" || errors+=("CA_FILE ${CA_FILE} is not a PEM certificate")
 local a
 for a in ${ADMINS}; do
  [[ "${a}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}:[^@:[:space:]]+@[^@:[:space:]]+$ ]] || errors+=("ADMINS entry '${a}' must be username:email (Coder usernames: letters, digits, - and _)")
 done
 [[ -n "${ADMINS}" || "${ATTACH}" == true ]] || errors+=("ADMINS is empty: nobody would be able to administer Coder through Keycloak")
 [[ "${ATTACH}" == true || "${ATTACH}" == false ]] || errors+=("ATTACH must be true or false")
 if [[ ${#errors[@]} -gt 0 ]]; then printf '%s\n' "${errors[@]/#/  config: }" >&2; die "fix ${CONFIG}"; fi
}

# ------------------------------------------------------------------------------------------------ tools
# Bundled static binaries (tools/) are used when the host has none (or an old one).
tool() {
 local name=$1
 if type -P "${name}" >/dev/null 2>&1; then type -P "${name}"   # executables only: never a function or alias
 elif [[ -x "${HERE}/tools/${name}" ]]; then echo "${HERE}/tools/${name}"
 else die "${name} is required (not on PATH and not in ${HERE}/tools/)"; fi
}
KUBECTL=""; HELM=""; CRANE=""
# crane, with --insecure for a plain-HTTP registry (a function named after the tool would shadow it in `tool crane`).
reg() { local flags=(); [[ "${REGISTRY_INSECURE}" == true ]] && flags=(--insecure); "${CRANE}" "$@" "${flags[@]}"; }
need_kube() { KUBECTL=$(tool kubectl); "${KUBECTL}" version --request-timeout=10s >/dev/null 2>&1 || die "kubectl can't reach the cluster (check KUBECONFIG / context: $("${KUBECTL}" config current-context 2>/dev/null || echo none))"; }
need_helm() {   # the host's helm if it's 3.14+, else the bundled one
 local h v
 for h in "$(command -v helm 2>/dev/null || true)" "${HERE}/tools/helm"; do
  [[ -n "${h}" && -x "${h}" ]] || continue
  v=$("${h}" version --template '{{.Version}}' 2>/dev/null || true)
  if [[ "${v}" =~ ^v3\.(1[4-9]|[2-9][0-9])\. || "${v}" =~ ^v([4-9]|[1-9][0-9])\. ]]; then HELM=${h}; return; fi
 done
 die "helm 3.14 or newer is required (not on PATH, and no tools/helm)"
}
k() { "${KUBECTL}" "$@"; }
kn() { "${KUBECTL}" -n "${NAMESPACE}" "$@"; }
confirm() {   # confirm <question>: yes/no, "no" under --yes
 [[ ${ASSUME_YES} -eq 1 ]] && return 1
 local a; read -r -p "  $1 [y/N] " a </dev/tty || return 1; [[ "${a}" =~ ^[Yy] ]]
}
ask_secret() {   # ask_secret <prompt> -> stdout
 [[ ${ASSUME_YES} -eq 1 ]] && die "$1 is needed (set it in the environment when using --yes)"
 local v; read -r -s -p "  $1: " v </dev/tty; echo >&2; [[ -n "${v}" ]] || die "$1 is empty"; printf '%s' "${v}"
}

# ------------------------------------------------------------------------------------------------ cluster facts
detect_section() {   # the Gateway's HTTPS listener, unless GATEWAY_SECTION is set
 [[ -n "${GATEWAY_SECTION}" ]] && { echo "${GATEWAY_SECTION}"; return; }
 local names
 names=$(k -n "${GATEWAY_NAMESPACE}" get gateway "${GATEWAY_NAME}" -o jsonpath='{range .spec.listeners[?(@.protocol=="HTTPS")]}{.name}{"\n"}{end}' 2>/dev/null || true)
 [[ $(printf '%s\n' "${names}" | grep -c .) -eq 1 ]] && echo "${names}" || true
}
cnpg_mode() {   # install | existing
 if [[ "${CNPG}" != auto ]]; then echo "${CNPG}"; return; fi
 local owner
 if k get crd clusters.postgresql.cnpg.io >/dev/null 2>&1; then
  owner=$(k get crd clusters.postgresql.cnpg.io -o jsonpath='{.metadata.annotations.meta\.helm\.sh/release-name}/{.metadata.annotations.meta\.helm\.sh/release-namespace}' 2>/dev/null || true)
  [[ "${owner}" == "${RELEASE}/${NAMESPACE}" || "${owner}" == "${CNPG_RELEASE}/cnpg-system" ]] && echo install || echo existing
 else echo install; fi
}
plugin_name() {   # the rewrite-body plugin's name in Traefik's arguments, or empty
 k -n "${TRAEFIK_NAMESPACE}" get deploy -o jsonpath='{range .items[*]}{.spec.template.spec.containers[*].args}{"\n"}{end}' 2>/dev/null \
  | grep -oE 'experimental\.(local)?[pP]lugins\.[A-Za-z0-9_-]+\.moduleName=github\.com/traefik/plugin-rewritebody' \
  | head -n1 | sed -E 's/experimental\.(local)?[pP]lugins\.([A-Za-z0-9_-]+)\..*/\2/' || true
}

# ------------------------------------------------------------------------------------------------ preflight
preflight() {
 step "configuration (${CONFIG})"
 validate_config; ok "install.conf is complete: Coder at https://${CODER_HOST}, images from ${REGISTRY}"
 [[ -n "${CHART}" ]] && ok "chart $(basename "${CHART}") (bundle ${BUNDLE_VERSION})" || bad "no charts/coder-platform-*.tgz next to this script"
 need_kube; need_helm; ok "kubectl ($(k config current-context 2>/dev/null)) and helm $("${HELM}" version --template '{{.Version}}')"

 step "cluster"
 local v; v=$(k get --raw /version 2>/dev/null | grep -o '"gitVersion": *"[^"]*"' | cut -d'"' -f4 || true)
 [[ "${v}" =~ ^v1\.(2[7-9]|[3-9][0-9]) ]] && ok "Kubernetes ${v}" || bad "Kubernetes ${v:-?}: 1.27 or newer is required"
 if k get ns "${NAMESPACE}" >/dev/null 2>&1; then ok "namespace ${NAMESPACE} exists"; else ok "namespace ${NAMESPACE} will be created"; fi
 local sc="${STORAGE_CLASS}"
 if [[ -n "${sc}" ]]; then k get storageclass "${sc}" >/dev/null 2>&1 && ok "StorageClass ${sc}" || bad "StorageClass ${sc} does not exist"
 else
  sc=$(k get storageclass -o jsonpath='{range .items[?(@.metadata.annotations.storageclass\.kubernetes\.io/is-default-class=="true")]}{.metadata.name}{"\n"}{end}' | head -n1)
  [[ -n "${sc}" ]] && ok "default StorageClass ${sc} (database, receipts, workspace homes)" || bad "no default StorageClass: set STORAGE_CLASS"
 fi
 case "$(cnpg_mode)" in
  install) if k get crd clusters.postgresql.cnpg.io >/dev/null 2>&1; then ok "CloudNativePG operator: managed by this release"
           else ok "CloudNativePG operator: will be installed (namespace cnpg-system)"; fi ;;
  existing) local img; img=$(k get deploy -A -l app.kubernetes.io/name=cloudnative-pg -o jsonpath='{.items[0].spec.template.spec.containers[0].image}' 2>/dev/null || true)
           [[ -n "${img}" ]] && ok "CloudNativePG operator already running (${img}): using it" || bad "CNPG CRDs exist but no operator Deployment was found (set CNPG=install?)" ;;
 esac

 step "Traefik and the Gateway"
 local timg; timg=$(k -n "${TRAEFIK_NAMESPACE}" get deploy -o jsonpath='{range .items[*]}{.spec.template.spec.containers[*].image}{"\n"}{end}' 2>/dev/null | grep -i traefik | head -n1 || true)
 if [[ -z "${timg}" ]]; then bad "no Traefik Deployment in namespace ${TRAEFIK_NAMESPACE} (set TRAEFIK_NAMESPACE)"
 elif [[ "${timg}" =~ :v?(3\.[0-9]+|[4-9]\.) ]]; then ok "Traefik ${timg##*:}"
 else warn "Traefik image ${timg}: v3.x is required (couldn't read the version from the tag)"; fi
 if k -n "${TRAEFIK_NAMESPACE}" get deploy -o jsonpath='{..args}' 2>/dev/null | grep -q 'providers.kubernetesgateway'; then ok "Traefik's Gateway API provider is on"
 else bad "Traefik's Gateway API provider is off (--providers.kubernetesgateway)"; fi
 local plugin; plugin=$(plugin_name)
 if [[ -n "${plugin}" ]]; then ok "rewrite-body plugin loaded as '${plugin}'"
 else warn "Traefik has no rewrite-body plugin yet: ./install plugin enables it (./install all does it for you)"; fi
 k get crd httproutes.gateway.networking.k8s.io >/dev/null 2>&1 && ok "Gateway API CRDs" || bad "Gateway API CRDs are missing"
 if k -n "${GATEWAY_NAMESPACE}" get gateway "${GATEWAY_NAME}" >/dev/null 2>&1; then
  ok "Gateway ${GATEWAY_NAMESPACE}/${GATEWAY_NAME}"
  local section; section=$(detect_section)
  if [[ -n "${section}" ]]; then
   ok "HTTPS listener '${section}'"
   local lh; lh=$(k -n "${GATEWAY_NAMESPACE}" get gateway "${GATEWAY_NAME}" -o jsonpath="{.spec.listeners[?(@.name==\"${section}\")].hostname}")
   case "${lh}" in
    ""|"*.${DOMAIN}"|"${CODER_HOST}") ok "listener hostname '${lh:-any}' covers ${CODER_HOST}" ;;
    *) bad "listener '${section}' only serves '${lh}', not ${CODER_HOST}" ;;
   esac
   local from; from=$(k -n "${GATEWAY_NAMESPACE}" get gateway "${GATEWAY_NAME}" -o jsonpath="{.spec.listeners[?(@.name==\"${section}\")].allowedRoutes.namespaces.from}")
   [[ "${from}" == All || ( "${from:-Same}" == Same && "${GATEWAY_NAMESPACE}" == "${NAMESPACE}" ) || "${from}" == Selector ]] \
    && ok "routes from namespace ${NAMESPACE} may attach (${from:-Same})" || bad "listener '${section}' doesn't accept routes from namespace ${NAMESPACE} (allowedRoutes.namespaces.from: ${from:-Same})"
  else
   warn "couldn't pick the HTTPS listener of the Gateway: set GATEWAY_SECTION (routes will attach to every listener)"
  fi
 else bad "Gateway ${GATEWAY_NAMESPACE}/${GATEWAY_NAME} not found (set GATEWAY_NAME / GATEWAY_NAMESPACE)"; fi

 step "DNS, TLS and Keycloak (from this host)"
 local curl_ca=(); [[ -n "${CA_FILE}" ]] && curl_ca=(--cacert "${CA_FILE}")
 if getent hosts "${CODER_HOST}" >/dev/null 2>&1; then ok "${CODER_HOST} resolves"; else warn "${CODER_HOST} doesn't resolve from this host (browsers need it, and *.${DOMAIN})"; fi
 getent hosts "anyapp--test.${DOMAIN}" >/dev/null 2>&1 && ok "wildcard *.${DOMAIN} resolves" || warn "*.${DOMAIN} doesn't resolve from this host (workspace apps need wildcard DNS)"
 if [[ "${OIDC_ENABLED}" == true ]]; then
  local oca=("${curl_ca[@]}"); [[ -n "${OIDC_CA_FILE}" ]] && oca=(--cacert "${OIDC_CA_FILE}")
  local disc; disc=$(curl -sS -m 10 "${oca[@]}" "${OIDC_ISSUER_URL%/}/.well-known/openid-configuration" 2>&1 || true)
  if grep -q '"issuer"' <<<"${disc}"; then ok "Keycloak answers at ${OIDC_ISSUER_URL}"
  else warn "couldn't read ${OIDC_ISSUER_URL}/.well-known/openid-configuration from this host (${disc:0:120}); Coder won't start if it can't either"; fi
 fi

 step "images (${REGISTRY})"
 check_images

 step "Secrets in ${NAMESPACE}"
 secret_state tls-ca "private CA" "${CA_FILE}"
 secret_state keycloaking-coder-ca "Keycloak's CA" "${OIDC_CA_FILE:-${CA_FILE}}"
 if [[ "${OIDC_ENABLED}" == true && "${ATTACH}" != true ]]; then
  kn get secret keycloaking-coder-oidc >/dev/null 2>&1 && ok "keycloaking-coder-oidc (OIDC client secret) exists" \
   || { [[ -n "${OIDC_CLIENT_SECRET:-}" ]] && ok "keycloaking-coder-oidc will be created from OIDC_CLIENT_SECRET" || warn "keycloaking-coder-oidc missing: ./install secrets asks for Keycloak's client secret"; }
 fi
 [[ -z "${PULL_SECRET}" ]] || { kn get secret "${PULL_SECRET}" >/dev/null 2>&1 && ok "${PULL_SECRET} (registry login) exists" || warn "${PULL_SECRET} missing: ./install secrets asks for the registry password"; }

 echo
 if [[ ${FAILURES} -gt 0 ]]; then echo "${R}${FAILURES} problem(s)${N} must be fixed first (${WARNINGS} warning(s))."; return 1; fi
 echo "${G}Preflight passed${N} (${WARNINGS} warning(s))."
}
secret_state() {   # secret_state <name> <what> <file>
 local cur
 if ! kn get secret "$1" >/dev/null 2>&1; then
  [[ -n "$3" ]] && ok "$1 ($2) will be created from $3" || ok "$1 ($2): none needed (public CA)"
  return
 fi
 cur=$(kn get secret "$1" -o jsonpath='{.data.ca\.crt}' | base64 -d 2>/dev/null || true)
 if [[ -z "$3" ]]; then ok "$1 ($2) exists"
 elif [[ "${cur}" == "$(cat "$3")" ]]; then ok "$1 ($2) exists and matches $3"
 else warn "$1 exists but differs from $3 (./install secrets --force replaces it)"; fi
}
check_images() {
 [[ -f "${IMAGES_LIST}" ]] || { bad "no ${IMAGES_LIST}"; return; }
 CRANE=$(tool crane)
 local file ref missing=0
 while read -r file ref; do
  [[ -n "${file}" && "${file}" != \#* ]] || continue
  if reg digest "${REGISTRY}/${ref}" >/dev/null 2>&1; then ok "${REGISTRY}/${ref}"
  else missing=$((missing + 1)); fi
 done < "${IMAGES_LIST}"
 [[ ${missing} -eq 0 ]] || warn "${missing} image(s) not in ${REGISTRY} yet: ./install images pushes them"
}

# ------------------------------------------------------------------------------------------------ images
ecr_token() {   # a 12-hour ECR login token: REGISTRY_PASSWORD if set, else the AWS CLI
 if [[ -n "${REGISTRY_PASSWORD:-}" ]]; then printf '%s' "${REGISTRY_PASSWORD}"; return; fi
 command -v aws >/dev/null || die "Amazon ECR: the AWS CLI is needed to log in (or set REGISTRY_PASSWORD=\$(aws ecr get-login-password --region ${AWS_REGION}) on a machine that has it)"
 aws ecr get-login-password --region "${AWS_REGION}" || die "aws ecr get-login-password failed (AWS credentials for region ${AWS_REGION}?)"
}
ecr_ensure_repo() {   # ecr_ensure_repo <repository name>: ECR doesn't create repositories on push
 command -v aws >/dev/null || { warn "no AWS CLI: make sure ECR repository $1 exists"; return 0; }
 aws ecr describe-repositories --region "${AWS_REGION}" --repository-names "$1" >/dev/null 2>&1 && return 0
 aws ecr create-repository --region "${AWS_REGION}" --repository-name "$1" --image-scanning-configuration scanOnPush=true >/dev/null \
  || die "creating ECR repository $1 failed (IAM permission ecr:CreateRepository?)"
 ok "created ECR repository $1"
}
push_images() {
 validate_config
 [[ -f "${IMAGES_LIST}" ]] || die "no ${IMAGES_LIST}"
 CRANE=$(tool crane)
 step "pushing images to ${REGISTRY}"
 local host=${REGISTRY%%/*}
 if [[ "${IS_ECR}" == true ]]; then
  ecr_token | reg auth login "${host}" -u AWS --password-stdin >/dev/null && ok "logged in to Amazon ECR (${AWS_REGION})"
 elif [[ -n "${REGISTRY_USERNAME}" ]] && ! reg catalog "${host}" >/dev/null 2>&1; then
  local pw="${REGISTRY_PASSWORD:-}"; [[ -n "${pw}" ]] || pw=$(ask_secret "password of ${REGISTRY_USERNAME} at ${host}")
  printf '%s' "${pw}" | reg auth login "${host}" -u "${REGISTRY_USERNAME}" --password-stdin >/dev/null
 fi
 local file ref n=0
 while read -r file ref; do
  [[ -n "${file}" && "${file}" != \#* ]] || continue
  n=$((n + 1))
  if reg digest "${REGISTRY}/${ref}" >/dev/null 2>&1 && [[ ${FORCE} -eq 0 ]]; then ok "${ref} (already there)"; continue; fi
  [[ "${IS_ECR}" == true ]] && ecr_ensure_repo "${REGISTRY_PATH:+${REGISTRY_PATH}/}${ref%:*}"
  echo "  push  ${ref}  ($(du -h "${HERE}/images/${file}" | cut -f1))"
  mkdir -p "${GEN}"
  reg push "${HERE}/images/${file}" "${REGISTRY}/${ref}" >/dev/null 2>"${GEN}/push.log" \
   || { tail -3 "${GEN}/push.log" >&2; die "pushing ${ref} failed (log: ${GEN}/push.log). A registry with a private CA: export SSL_CERT_FILE=<CA bundle>"; }
  ok "${REGISTRY}/${ref}"
 done < "${IMAGES_LIST}"
 echo "  ${n} image(s) in ${REGISTRY}"
}

# ------------------------------------------------------------------------------------------------ secrets
ensure_ns() { k get ns "${NAMESPACE}" >/dev/null 2>&1 || k create namespace "${NAMESPACE}" >/dev/null; }
put_ca_secret() {   # put_ca_secret <name> <file>
 [[ -n "$2" ]] || return 0
 if kn get secret "$1" >/dev/null 2>&1; then
  local cur; cur=$(kn get secret "$1" -o jsonpath='{.data.ca\.crt}' | base64 -d 2>/dev/null || true)
  if [[ "${cur}" == "$(cat "$2")" ]]; then ok "$1 (matches $2)"; return; fi
  [[ ${FORCE} -eq 1 ]] || { warn "$1 exists and differs from $2; kept (--force replaces it)"; return; }
  kn create secret generic "$1" --from-file=ca.crt="$2" --dry-run=client -o yaml | kn apply -f - >/dev/null; ok "$1 replaced from $2"
 else
  kn create secret generic "$1" --from-file=ca.crt="$2" >/dev/null; ok "$1 created from $2"
 fi
 kn label secret "$1" app.kubernetes.io/part-of=coder --overwrite >/dev/null
}
create_secrets() {
 validate_config; need_kube
 step "Secrets in ${NAMESPACE}"
 ensure_ns
 put_ca_secret tls-ca "${CA_FILE}"
 put_ca_secret keycloaking-coder-ca "${OIDC_CA_FILE:-${CA_FILE}}"
 # (an existing Coder keeps its own client-secret Secret: nothing to create in attach mode)
 if [[ "${OIDC_ENABLED}" == true && "${ATTACH}" != true ]]; then
  if kn get secret keycloaking-coder-oidc >/dev/null 2>&1 && [[ ${FORCE} -eq 0 || -z "${OIDC_CLIENT_SECRET:-}" ]]; then ok "keycloaking-coder-oidc exists"
  else
   local s="${OIDC_CLIENT_SECRET:-}"; [[ -n "${s}" ]] || s=$(ask_secret "client secret of Keycloak client '${OIDC_CLIENT_ID}' (Keycloak > Clients > ${OIDC_CLIENT_ID} > Credentials)")
   kn create secret generic keycloaking-coder-oidc --from-literal=client-secret="${s}" --dry-run=client -o yaml | kn apply -f - >/dev/null
   kn label secret keycloaking-coder-oidc app.kubernetes.io/part-of=coder --overwrite >/dev/null
   ok "keycloaking-coder-oidc created"
  fi
 fi
 if [[ -n "${PULL_SECRET}" ]]; then
  if kn get secret "${PULL_SECRET}" >/dev/null 2>&1 && [[ ${FORCE} -eq 0 ]]; then ok "${PULL_SECRET} exists"
  else
   local pw="${REGISTRY_PASSWORD:-}"; [[ -n "${pw}" ]] || pw=$(ask_secret "password of ${REGISTRY_USERNAME} at ${REGISTRY%%/*} (image pulls)")
   kn create secret docker-registry "${PULL_SECRET}" --docker-server="${REGISTRY%%/*}" --docker-username="${REGISTRY_USERNAME}" \
    --docker-password="${pw}" --dry-run=client -o yaml | kn apply -f - >/dev/null
   ok "${PULL_SECRET} created"
  fi
 fi
}

# ------------------------------------------------------------------------------------------------ Traefik plugin
enable_plugin() {
 need_kube
 step "Traefik rewrite-body plugin"
 local p; p=$(plugin_name)
 if [[ -n "${p}" ]]; then ok "already loaded as '${p}'"; return 0; fi
 echo "  Traefik (namespace ${TRAEFIK_NAMESPACE}) runs without the rewrite-body plugin. The bundled copy is added to the"
 echo "  running Deployment (one argument, one volume, one ConfigMap; it rolls back by itself if Traefik doesn't load it)."
 [[ ${ASSUME_YES} -eq 1 ]] || confirm "Enable it now?" || die "not enabled: the dashboard add-ons need it (see traefik-plugin/README)"
 local rc=0
 NS="${TRAEFIK_NAMESPACE}" PATH="${HERE}/tools:${PATH}" "${HERE}/traefik-plugin/enable-plugin" --airgap || rc=$?
 case ${rc} in
  0) ok "plugin enabled" ;;
  4) echo; echo "  Traefik is managed by Argo CD / Flux, so it must be changed there. These values add the plugin:"
     NS="${TRAEFIK_NAMESPACE}" "${HERE}/traefik-plugin/gen-airgap-plugin-values" || true
     die "add the values above to Traefik's Application, sync it, then run ./install again" ;;
  *) die "enabling the plugin failed (exit ${rc}); Traefik is back on its previous configuration" ;;
 esac
}

# ------------------------------------------------------------------------------------------------ values
write_values() {
 validate_config; need_kube; need_helm
 mkdir -p "${GEN}"
 local section cnpg plugin pullsec="[]" admins="" a u e
 section=$(detect_section); cnpg=$(cnpg_mode); plugin=$(plugin_name)
 [[ -n "${PULL_SECRET}" ]] && pullsec="[${PULL_SECRET}]"
 for a in ${ADMINS}; do u=${a%%:*}; e=${a#*:}; admins+="  - {username: ${u}, email: \"${e}\"}"$'\n'; done
 local coder_tag coder_repo
 coder_repo="${REGISTRY}/coder-platform/coder"
 coder_tag=$(awk '$2 ~ /^coder-platform\/coder:/ {sub(/.*:/, "", $2); print $2}' "${IMAGES_LIST}" 2>/dev/null | head -n1)
 local ws_image; ws_image=$(awk '$2 ~ /^coder-platform\/workspace:/ {print $2}' "${IMAGES_LIST}" 2>/dev/null | head -n1)
 cat > "${GEN}/values.yaml" <<EOF
# Generated by ./install values from ${CONFIG} ($(date -u +%Y-%m-%dT%H:%M:%SZ), bundle ${BUNDLE_VERSION}).
# Re-generated on every ./install deploy: change install.conf, or put your own overrides in values-local.yaml
# (applied after this file).
global:
  domain: ${DOMAIN}
  imageRegistry: ${REGISTRY}
  imagePullSecrets: ${pullsec}
  storageClass: "${STORAGE_CLASS}"
gateway:
  name: ${GATEWAY_NAME}
  namespace: ${GATEWAY_NAMESPACE}
  sectionName: "${section}"
traefik:
  pluginName: ${plugin:-rewrite-body}
oidc:
  enabled: ${OIDC_ENABLED}
  issuerURL: "${OIDC_ISSUER_URL}"
  clientID: ${OIDC_CLIENT_ID}
  keycloakNamespace: "${KEYCLOAK_NAMESPACE}"
  groupField: "${OIDC_GROUP_FIELD:-}"
  allowedGroups: [$(for g in ${OIDC_ALLOWED_GROUPS:-}; do printf '"%s",' "${g}"; done | sed 's/,$//')]
admins:
${admins:-  []}
attach:
  enabled: ${ATTACH}
  coderService: ${CODER_SERVICE}
  coderDeployment: ${CODER_DEPLOYMENT}
postgres:
  enabled: $([[ "${ATTACH}" == true ]] && echo false || echo true)
  name: ${POSTGRES_NAME}
uiUpdates:
  oidcSecretName: "${OIDC_SECRET_NAME:-keycloaking-coder-oidc}"
  coderDB:
    secretName: "${CODER_DB_SECRET}"
    secretKey: "${CODER_DB_SECRET_KEY}"
    caSecretName: "${CODER_DB_CA_SECRET}"
workspaces:
  namespace: "${WORKSPACE_NAMESPACE}"
  template:
    enabled: ${TEMPLATE_ENABLED}
    name: ${TEMPLATE_NAME}
    image: ${ws_image:-coder-platform/workspace:latest}
cloudnative-pg:
  enabled: $([[ "${cnpg}" == install && "${DEPLOY}" == argocd ]] && echo true || echo false)
  image:
    repository: ${REGISTRY}/cloudnative-pg/cloudnative-pg
  imagePullSecrets: $([[ -n "${PULL_SECRET}" ]] && echo "[{name: ${PULL_SECRET}}]" || echo "[]")
coder-banner:
  coder:
    host: ${CODER_HOST}
  gateway:
    name: ${GATEWAY_NAME}
    namespace: ${GATEWAY_NAMESPACE}
    sectionName: "${section}"
  image:
    registry: ${REGISTRY}
    repository: library/python
    tag: 3.13-alpine
  imagePullSecrets: $([[ -n "${PULL_SECRET}" ]] && echo "[{name: ${PULL_SECRET}}]" || echo "[]")
coder:
  enabled: $([[ "${ATTACH}" == true ]] && echo false || echo true)
  coder:
    image:
      repo: ${coder_repo}
      tag: "${coder_tag:-v2.37.3}"
      pullSecrets: $([[ -n "${PULL_SECRET}" ]] && echo "[{name: ${PULL_SECRET}}]" || echo "[]")
EOF
 # Coder reads its settings from a ConfigMap (+ the OIDC Secret): changing either must restart it, so their checksum
 # goes into Coder's pod annotations.
 if [[ "${ATTACH}" != true ]]; then
 local sum
 sum=$( { "${HELM}" template "${RELEASE}" "${CHART}" -n "${NAMESPACE}" -f "${GEN}/values.yaml" $(local_values) --show-only templates/coder-config.yaml 2>/dev/null
          kn get secret keycloaking-coder-oidc keycloaking-coder-ca tls-ca -o jsonpath='{..data}' 2>/dev/null || true; } | sha256sum | cut -c1-16)
 cat >> "${GEN}/values.yaml" <<EOF
    podAnnotations:
      checksum/config: "${sum}"
EOF
 fi
 "${HELM}" template "${RELEASE}" "${CHART}" -n "${NAMESPACE}" -f "${GEN}/values.yaml" $(local_values) >/dev/null \
  || die "the chart doesn't render with ${GEN}/values.yaml (see above)"
}
local_values() { [[ -f "${HERE}/values-local.yaml" ]] && echo "-f ${HERE}/values-local.yaml" || true; }

# ------------------------------------------------------------------------------------------------ deploy
unstick() {   # unstick <namespace>: restart Deployments whose last rollout timed out (e.g. an earlier image-pull
 # problem, since fixed). Re-running helm doesn't start a new rollout, and helm would fail on the stale condition.
 local line
 while read -r line; do
  [[ "${line}" == *=ProgressDeadlineExceeded ]] || continue
  k -n "$1" rollout restart deploy/"${line%%=*}" >/dev/null && echo "  restarted ${line%%=*} (its previous rollout had timed out)"
 done < <(k -n "$1" get deploy -o jsonpath='{range .items[*]}{.metadata.name}{"="}{.status.conditions[?(@.type=="Progressing")].reason}{"\n"}{end}' 2>/dev/null || true)
}
# The dashboard add-ons' default images (bundle defaults/logo.<ext>, avatar.<ext>, from coder-ui-updates'
# resources/defaults/): one ConfigMap each, which the add-on service mounts if present. A fresh database starts with the
# logo; users without a picture show the avatar. Not part of the chart on purpose: Helm keeps the whole chart in its
# release record (1 MiB at most), which an animated GIF would overflow. Made before the chart, so the service sees them
# at its first start (that is when it installs the default logo). Server-side apply: no last-applied copy of the image.
put_defaults() {
 local kind f n=0
 for kind in logo avatar; do
  f=$(ls "${HERE}/defaults/${kind}".{png,jpg,jpeg,gif,webp,svg} 2>/dev/null | head -n1 || true)
  [[ -n "${f}" ]] || continue
  [[ $(stat -c%s "${f}") -le 1048576 ]] || die "${f} is larger than 1 MiB (one ConfigMap per default image)"
  [[ ${n} -eq 0 ]] && { step "default images (ConfigMaps coder-ui-updates-default-*)"; ensure_ns; }
  n=$((n + 1))
  kn create configmap "coder-ui-updates-default-${kind}" --from-file="${f}" --dry-run=client -o yaml \
   | k label --local -f - -o yaml app.kubernetes.io/name=coder-ui-updates app.kubernetes.io/part-of=coder \
   | k apply --server-side --field-manager=coder-platform-install -f - >/dev/null
  ok "default ${kind}: ${f##*/} ($(stat -c%s "${f}") bytes)"
 done
 return 0
}
deploy() {
 write_values
 local p; p=$(plugin_name)
 [[ -n "${p}" ]] || die "Traefik has no rewrite-body plugin: run ./install plugin first"
 if [[ "${OIDC_ENABLED}" == true && "${ATTACH}" != true ]] && ! kn get secret keycloaking-coder-oidc >/dev/null 2>&1; then die "Secret keycloaking-coder-oidc is missing: run ./install secrets first"; fi
 put_defaults
 if [[ "${DEPLOY}" == argocd ]]; then deploy_argocd; return; fi
 if [[ "$(cnpg_mode)" == install && "${ATTACH}" != true ]]; then
  [[ -n "${CNPG_CHART}" ]] || die "no charts/cloudnative-pg-*.tgz in the bundle"
  step "CloudNativePG operator (release ${CNPG_RELEASE}, namespace cnpg-system)"
  local cnpg_pull=(); [[ -n "${PULL_SECRET}" ]] && cnpg_pull=(--set "imagePullSecrets[0].name=${PULL_SECRET}")
  if [[ -n "${PULL_SECRET}" ]] && ! k -n cnpg-system get secret "${PULL_SECRET}" >/dev/null 2>&1; then
   k create namespace cnpg-system --dry-run=client -o yaml | k apply -f - >/dev/null
   kn get secret "${PULL_SECRET}" -o json | sed -e "s/\"namespace\": *\"${NAMESPACE}\"/\"namespace\": \"cnpg-system\"/" \
    -e '/"resourceVersion"/d; /"uid"/d; /"creationTimestamp"/d' | k apply -f - >/dev/null
  fi
  unstick cnpg-system
  "${HELM}" upgrade --install "${CNPG_RELEASE}" "${CNPG_CHART}" -n cnpg-system --create-namespace \
   --set fullnameOverride=cloudnative-pg --set "image.repository=${REGISTRY}/cloudnative-pg/cloudnative-pg" "${cnpg_pull[@]}" \
   --wait --timeout 10m >/dev/null || die "installing the CloudNativePG operator failed"
  ok "operator running ($(k -n cnpg-system get deploy cloudnative-pg -o jsonpath='{.spec.template.spec.containers[0].image}'))"
 fi
 step "helm upgrade --install ${RELEASE} (namespace ${NAMESPACE})"
 echo "  first installs take 5-15 minutes: database, Coder, then the bootstrap Job pushes the workspace template"
 unstick "${NAMESPACE}"
 "${HELM}" upgrade --install "${RELEASE}" "${CHART}" -n "${NAMESPACE}" --create-namespace \
  -f "${GEN}/values.yaml" $(local_values) --wait --wait-for-jobs --timeout 30m \
  || { echo; echo "  The release did not become ready. ./install status shows what is waiting (and the bootstrap Job's log)."; exit 1; }
 ok "release ${RELEASE} deployed"
}
# Registry login for Helm (OCI charts): ECR token, or REGISTRY_USERNAME + password. Sets REG_USER / REG_PW.
REG_USER=""; REG_PW=""
helm_login() {
 [[ -n "${REG_USER}" ]] && return 0
 local plain=(); [[ "${REGISTRY_INSECURE}" == true ]] && plain=(--insecure)
 REG_USER="${REGISTRY_USERNAME}"; REG_PW="${REGISTRY_PASSWORD:-}"
 if [[ "${IS_ECR}" == true ]]; then REG_USER=AWS; REG_PW=$(ecr_token)
 elif [[ -n "${REG_USER}" && -z "${REG_PW}" ]]; then REG_PW=$(ask_secret "password of ${REG_USER} at ${REGISTRY%%/*} (chart push)"); fi
 [[ -n "${REG_USER}" ]] && printf '%s' "${REG_PW}" | "${HELM}" registry login "${REGISTRY%%/*}" -u "${REG_USER}" --password-stdin "${plain[@]}" >/dev/null
 return 0
}
push_chart() {   # push_chart <chart .tgz> -> oci://<REGISTRY>/charts/<name>:<version>
 need_helm; helm_login
 local plain=(); [[ "${REGISTRY_INSECURE}" == true ]] && plain=(--plain-http)
 local name; name=$(basename "$1" .tgz); name=${name%-*}; [[ "${name}" == coder_helm* ]] && name=coder
 [[ "${IS_ECR}" == true ]] && ecr_ensure_repo "${REGISTRY_PATH:+${REGISTRY_PATH}/}charts/${name}"
 step "pushing $(basename "$1") to oci://${REGISTRY}/charts"
 "${HELM}" push "$1" "oci://${REGISTRY}/charts" "${plain[@]}" >/dev/null || die "helm push failed"
 ok "oci://${REGISTRY}/charts/${name}"
}
register_argocd_repo() {   # Secret <argocd ns>/coder-platform-oci in the Argo CD cluster (ARGOCD_CONTEXT); rewritten each time
 need_kube; need_helm; helm_login
 local hub=("${KUBECTL}"); [[ -n "${ARGOCD_CONTEXT}" ]] && hub+=(--context "${ARGOCD_CONTEXT}")
 local repo="${REGISTRY}/charts"
 step "Argo CD repository ${repo} (Secret ${ARGOCD_NAMESPACE}/coder-platform-oci${ARGOCD_CONTEXT:+ at ${ARGOCD_CONTEXT}})"
 local args=(--from-literal=type=helm --from-literal=name=coder-platform --from-literal=enableOCI=true --from-literal=url="${repo}")
 [[ -n "${REG_USER}" ]] && args+=(--from-literal=username="${REG_USER}" --from-literal=password="${REG_PW}")
 [[ "${REGISTRY_INSECURE}" == true ]] && args+=(--from-literal=insecureOCIForceHttp=true)
 "${hub[@]}" -n "${ARGOCD_NAMESPACE}" create secret generic coder-platform-oci "${args[@]}" --dry-run=client -o yaml \
  | "${hub[@]}" label --local -f - argocd.argoproj.io/secret-type=repository -o yaml | "${hub[@]}" apply -f - >/dev/null
 ok "registered (Argo CD pulls charts from ${repo})"
 [[ "${IS_ECR}" == true ]] && warn "the ECR login in that Secret lasts 12 hours; Argo CD needs it only to fetch a new chart version. Renew it with ./install argocd-repo"
 return 0
}
deploy_argocd() {
 need_kube
 # Argo CD may run on another cluster (hub-and-spoke): ARGOCD_CONTEXT is its kube context.
 local hub=("${KUBECTL}"); [[ -n "${ARGOCD_CONTEXT}" ]] && hub+=(--context "${ARGOCD_CONTEXT}")
 local dest="${ARGOCD_DEST_SERVER}"
 "${hub[@]}" get crd applications.argoproj.io >/dev/null 2>&1 || die "Argo CD isn't installed where ARGOCD_CONTEXT (${ARGOCD_CONTEXT:-current context}) points"
 if [[ -n "${ARGOCD_CONTEXT}" && -z "${dest}" ]]; then
  dest=$(k config view --minify -o jsonpath='{.clusters[0].cluster.server}')
  "${hub[@]}" -n "${ARGOCD_NAMESPACE}" get secret -l argocd.argoproj.io/secret-type=cluster -o jsonpath='{range .items[*]}{.data.server}{"\n"}{end}' \
   | while read -r b; do printf '%s\n' "$(printf '%s' "${b}" | base64 -d)"; done | grep -qxF "${dest}" \
   || die "this cluster (${dest}) isn't registered in the Argo CD at ${ARGOCD_CONTEXT} (argocd cluster add <context>), or set ARGOCD_DEST_SERVER"
  ok "this cluster is registered in the hub's Argo CD as ${dest}"
 fi
 dest="${dest:-https://kubernetes.default.svc}"
 local ver repo="${REGISTRY}/charts"
 ver=$(basename "${CHART}" .tgz); ver=${ver#coder-platform-}
 push_chart "${CHART}"
 register_argocd_repo
 step "Argo CD Application ${ARGOCD_NAMESPACE}/${RELEASE}"
 {
  cat <<EOF
# Generated by ./install deploy (DEPLOY=argocd). The chart comes from the Helm OCI repository ${repo}
# (registered by ./install as Secret ${ARGOCD_NAMESPACE}/coder-platform-oci).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ${RELEASE}
  namespace: ${ARGOCD_NAMESPACE}
  annotations:
    # The CNPG CRDs are too big for client-side apply; server-side apply then needs server-side diff, or routes stay OutOfSync.
    argocd.argoproj.io/compare-options: ServerSideDiff=true
  finalizers: [resources-finalizer.argocd.argoproj.io]
spec:
  project: ${ARGOCD_PROJECT}
  destination:
    server: ${dest}
    namespace: ${NAMESPACE}
  source:
    repoURL: ${repo}
    chart: coder-platform
    targetRevision: "${ver}"
    helm:
      releaseName: ${RELEASE}
      valuesObject:
EOF
  cat "${GEN}/values.yaml" $( [[ -f "${HERE}/values-local.yaml" ]] && echo "${HERE}/values-local.yaml" ) | grep -v '^#' | sed 's/^/        /'
  cat <<EOF
  syncPolicy:
    automated: {prune: true, selfHeal: true}
    syncOptions: [CreateNamespace=true, ServerSideApply=true]
EOF
 } > "${GEN}/argocd-application.yaml"
 ok "${GEN}/argocd-application.yaml"
 if [[ -f "${HERE}/values-local.yaml" ]]; then warn "values-local.yaml was appended after values.yaml: check the Application's valuesObject merges as you expect"; fi
 "${hub[@]}" apply -f "${GEN}/argocd-application.yaml" >/dev/null && ok "applied${ARGOCD_CONTEXT:+ (Argo CD at ${ARGOCD_CONTEXT})}"
 echo "  waiting for Argo CD to sync it (first installs take 5-15 minutes)"
 local deadline=$(( $(date +%s) + 1800 )) state=""
 while :; do
  state=$("${hub[@]}" -n "${ARGOCD_NAMESPACE}" get application "${RELEASE}" -o jsonpath='{.status.sync.status}/{.status.health.status}/{.status.operationState.phase}' 2>/dev/null || true)
  [[ "${state}" == Synced/Healthy/Succeeded ]] && break
  [[ "${state}" == */Failed || "${state}" == */Error ]] && { "${hub[@]}" -n "${ARGOCD_NAMESPACE}" get application "${RELEASE}" -o jsonpath='{.status.operationState.message}{"\n"}'; die "Argo CD sync failed (${state})"; }
  [[ $(date +%s) -lt ${deadline} ]] || die "Argo CD didn't finish in 30 minutes (${state}): kubectl -n ${ARGOCD_NAMESPACE} get application ${RELEASE} -o yaml"
  sleep 10
 done
 ok "Application ${RELEASE}: Synced, Healthy"
}

# ------------------------------------------------------------------------------------------------ verify / status
verify() {
 validate_config; need_kube
 step "workloads in ${NAMESPACE}"
 local d
 for d in "${CODER_DEPLOYMENT}" coder-ui-updates coder-ui-logs-db coder-banner coder-workspace-icons; do
  kn get deploy "${d}" >/dev/null 2>&1 || { bad "Deployment ${d} not found"; continue; }
  kn rollout status deploy/"${d}" --timeout=300s >/dev/null 2>&1 && ok "${d} ready" || bad "${d} not ready (kubectl -n ${NAMESPACE} describe deploy/${d})"
 done
 local pg; pg=$(kn get cluster.postgresql.cnpg.io "${POSTGRES_NAME}" -o jsonpath='{.status.phase}' 2>/dev/null || true)
 if [[ "${pg}" == "Cluster in healthy state" ]]; then ok "database ${POSTGRES_NAME}: ${pg}"
 elif [[ -z "${pg}" && "${ATTACH}" == true ]]; then ok "database: not a CloudNativePG cluster in ${NAMESPACE} (Coder's own; not checked here)"
 else bad "database ${POSTGRES_NAME}: ${pg:-not found}"; fi
 local job; job=$(kn get job coder-platform-bootstrap -o jsonpath='{.status.succeeded}' 2>/dev/null || true)
 [[ "${job}" == 1 ]] && ok "bootstrap Job succeeded (admins, workspace template)" || bad "bootstrap Job hasn't succeeded: kubectl -n ${NAMESPACE} logs job/coder-platform-bootstrap"

 step "through the Gateway (https://${CODER_HOST}${CODER_ADDRESS:+ at ${CODER_ADDRESS}})"
 local curl_ca=(); [[ -n "${CA_FILE}" ]] && curl_ca=(--cacert "${CA_FILE}")
 [[ -n "${CODER_ADDRESS}" ]] && curl_ca+=(--connect-to "${CODER_HOST}:443:${CODER_ADDRESS}:443")
 local code; code=$(curl -sS -m 15 "${curl_ca[@]}" -o /dev/null -w '%{http_code}' "https://${CODER_HOST}/healthz" 2>&1 || true)
 [[ "${code}" == 200 ]] && ok "https://${CODER_HOST}/healthz" || bad "https://${CODER_HOST}/healthz answered '${code}' (DNS, certificate or route)"
 local methods; methods=$(curl -sS -m 15 "${curl_ca[@]}" "https://${CODER_HOST}/api/v2/users/authmethods" 2>/dev/null || true)
 if [[ "${OIDC_ENABLED}" == true ]]; then grep -q '"oidc":{"enabled":true' <<<"${methods//[[:space:]]/}" && ok "Keycloak sign-in enabled" || bad "Keycloak sign-in isn't enabled: ${methods:0:160}"; fi
 # The dashboard add-ons: the same checks as ../coder-ui-updates/coder-ui-updates verify (bundled under verify/).
 if [[ -x "${HERE}/verify/coder-ui-updates/coder-ui-updates" ]]; then
  step "dashboard add-ons"
  local out rc=0
  out=$(CODER_NAMESPACE="${NAMESPACE}" TRAEFIK_NAMESPACE="${TRAEFIK_NAMESPACE}" CODER_CA_FILE="${CA_FILE}" CODER_URL="https://${CODER_HOST}" CODER_ADDRESS="${CODER_ADDRESS}" \
        PATH="${HERE}/tools:${PATH}" "${HERE}/verify/coder-ui-updates/coder-ui-updates" verify 2>&1) || rc=$?
  echo "${out}" | grep -E '^(OK|FAIL)' | sed 's/^OK  /  OK  /; s/^FAIL/  FAIL/'
  local nf; nf=$(grep -c '^FAIL' <<<"${out}" || true)
  [[ ${rc} -eq 0 && ${nf} -eq 0 ]] || { FAILURES=$((FAILURES + ${nf:-1})); echo "${out}" | grep -vE '^(OK|FAIL)' | sed 's/^/  /' | tail -5; }
 fi
 echo
 if [[ ${FAILURES} -gt 0 ]]; then echo "${R}${FAILURES} check(s) failed.${N}"; return 1; fi
 echo "${G}All checks passed.${N} Coder: https://${CODER_HOST}${ADMINS:+  (sign in with Keycloak as one of: ${ADMINS})}"
}
status() {
 need_kube
 step "release"; "$(tool helm)" -n "${NAMESPACE}" status "${RELEASE}" 2>/dev/null | head -6 || echo "  no Helm release ${RELEASE} in ${NAMESPACE}"
 step "pods"; kn get pods -o wide 2>/dev/null | grep -v '^coder-[0-9a-f]\{8\}-' || true
 step "bootstrap Job log (last 30 lines)"; kn logs job/coder-platform-bootstrap --tail=30 2>/dev/null | sed 's/^/  /' || echo "  (no Job yet)"
 step "break-glass admin"
 echo "  kubectl -n ${NAMESPACE} get secret coder-init-auth -o jsonpath='{.data.password}' | base64 -d; echo"
 echo "  (owner with a password; normal sign-in is Keycloak. Use it only if nobody can sign in with Keycloak.)"
}

case "${ACTION}" in
 preflight) preflight ;;
 images) push_images ;;
 secrets) create_secrets ;;
 plugin) enable_plugin ;;
 values) write_values; cat "${GEN}/values.yaml" ;;
 argocd-repo) register_argocd_repo ;;
 push-chart) validate_config; push_chart "${CHART_FILE:?set CHART_FILE=<chart .tgz>}" ;;
 deploy) deploy ;;
 verify) verify ;;
 status) status ;;
 all)
  preflight || die "preflight failed: fix the problems above and run ./install all again"
  push_images; create_secrets; enable_plugin; deploy; verify ;;
 *) die "unknown action '${ACTION}' (./install --help)" ;;
esac
