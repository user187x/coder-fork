#!/bin/bash
# Builds the air-gap bundle: one archive with everything an offline cluster needs to reach the same state as this
# platform (chart + subcharts, every image, the installer, the Traefik plugin, static helm/kubectl/crane/jq).
#
#   ./build-bundle                    -> dist/coder-platform-airgap-<version>.tar.gz (+ .sha256)
#   ./build-bundle --no-images        chart, installer and tools only (quick check of everything but the images)
#   ./build-bundle --keep-dir         also keep the unpacked dist/coder-platform-airgap-<version>/ (for testing)
#   EXTRA_PROVIDERS="hashicorp/aws:5.100.0 hashicorp/random:3.7.2" ./build-bundle
#                                     also put these Terraform providers into Coder's offline mirror (templates on the
#                                     target that need more than the bundled template does; ./upgrade tfcheck finds them)
#
# Needs (on this connected machine): docker (builds the two images), helm, curl, sha256sum.
# Versions are pinned below; change them here and in the chart together.
set -euo pipefail
cd "$(dirname "$0")"
ROOT=$(pwd)

CODER_VERSION=2.37.3                     # chart/coder-platform/Chart.yaml appVersion + coder dependency
WORKSPACE_TAG=2026.09.28                 # chart values workspaces.template.image
CNPG_OPERATOR=ghcr.io/cloudnative-pg/cloudnative-pg:1.30.1      # the cloudnative-pg 0.29.1 chart's appVersion
POSTGRES=ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie    # chart values postgres.image
PYTHON=docker.io/library/python:3.13-alpine                      # uiUpdates.image, coder-banner image
NGINX=docker.io/nginxinc/nginx-unprivileged:1.30.5-alpine        # workspaces.icons.image
HELM_VERSION=v3.22.0; KUBECTL_VERSION=v1.35.1; CRANE_VERSION=v0.22.1; JQ_VERSION=jq-1.8.2
PLATFORM=linux/amd64

images=1; keep=0
for a in "$@"; do case "$a" in --no-images) images=0 ;; --keep-dir) keep=1 ;; *) echo "usage: $0 [--no-images] [--keep-dir]" >&2; exit 2 ;; esac; done

CHART_DIR=chart/coder-platform
CHART_VERSION=$(sed -n 's/^version: *//p' "${CHART_DIR}/Chart.yaml")
VERSION="${CHART_VERSION}-coder${CODER_VERSION}"
NAME="coder-platform-airgap-${VERSION}"
OUT="dist/${NAME}"
CACHE="dist/.cache"
say() { echo; echo "== $*"; }

# Sanity: the pins here agree with the chart.
grep -q "^appVersion: \"${CODER_VERSION}\"" "${CHART_DIR}/Chart.yaml" || { echo "Chart.yaml appVersion != ${CODER_VERSION}" >&2; exit 1; }
grep -q "image: coder-platform/workspace:${WORKSPACE_TAG}$" "${CHART_DIR}/values.yaml" || { echo "values.yaml workspaces.template.image != coder-platform/workspace:${WORKSPACE_TAG}" >&2; exit 1; }
grep -q "image: ${POSTGRES}$" "${CHART_DIR}/values.yaml" || { echo "values.yaml postgres.image != ${POSTGRES}" >&2; exit 1; }
grep -q "image: ${PYTHON}" "${CHART_DIR}/values.yaml" || { echo "values.yaml uiUpdates.image != ${PYTHON}" >&2; exit 1; }
grep -q "image: ${NGINX}$" "${CHART_DIR}/values.yaml" || { echo "values.yaml icons image != ${NGINX}" >&2; exit 1; }

say "chart sources"
./sync-sources
mkdir -p "${CHART_DIR}/charts"
[[ -f "${CHART_DIR}/charts/coder_helm_${CODER_VERSION}.tgz" ]] || helm pull coder --repo https://helm.coder.com/v2 --version "${CODER_VERSION}" -d "${CHART_DIR}/charts"
[[ -f "${CHART_DIR}/charts/cloudnative-pg-0.29.1.tgz" ]] || helm pull cloudnative-pg --repo https://cloudnative-pg.github.io/charts --version 0.29.1 -d "${CHART_DIR}/charts"
helm lint "${CHART_DIR}" --set global.domain=example.com --set oidc.issuerURL=https://kc.example.com/realms/x --set coder-banner.coder.host=coder.example.com >/dev/null
rm -rf "${OUT}"; mkdir -p "${OUT}"/{charts,images,tools,verify}
helm package "${CHART_DIR}" -d "${OUT}/charts" >/dev/null
cp "${CHART_DIR}/charts/cloudnative-pg-0.29.1.tgz" "${OUT}/charts/"   # DEPLOY=helm installs the operator on its own first
echo "  $(ls "${OUT}"/charts)"

say "installer, Traefik plugin, verification"
cp installer/install installer/upgrade installer/install.conf.example "${OUT}/"
cp -r docs "${OUT}/docs"
cp "${CHART_DIR}/charts/coder_helm_${CODER_VERSION}.tgz" "${OUT}/charts/"   # ./upgrade coder: the upstream Coder chart on its own
cp README.md "${OUT}/README.md"
[[ -f AGENTS.md ]] && cp AGENTS.md "${OUT}/AGENTS.md"
cp INSTALL-HELM.txt INSTALL-ARGOCD.txt UPGRADE-EXISTING.txt "${OUT}/"
cp -r ../banner-update/traefik-plugin "${OUT}/traefik-plugin"
mkdir -p "${OUT}/verify/coder-ui-updates"
cp ../coder-ui-updates/coder-ui-updates "${OUT}/verify/coder-ui-updates/"
cp -r ../coder-ui-updates/resources "${OUT}/verify/coder-ui-updates/resources"
# The add-ons' default images (../coder-ui-updates/coder-ui-updates export-defaults): ./install deploy makes their
# ConfigMaps. Outside the chart: Helm's release record (1 MiB) can't hold an animated GIF.
if compgen -G "../coder-ui-updates/resources/defaults/*" >/dev/null; then
 cp -r ../coder-ui-updates/resources/defaults "${OUT}/defaults"
 echo "  default images: $(cd "${OUT}/defaults" && ls | tr '\n' ' ')"
fi
echo "${VERSION}" > "${OUT}/VERSION"

say "tools (${PLATFORM})"
mkdir -p "${CACHE}"
fetch() {   # fetch <url> <sha256 or url of a checksum file> <file in cache>
 local url=$1 sum=$2 file="${CACHE}/$3" want
 if [[ ! -f "${file}" ]]; then curl -fsSL -o "${file}.part" "${url}"; mv "${file}.part" "${file}"; fi
 if [[ "${sum}" == http* ]]; then want=$(curl -fsSL "${sum}" | grep -E "(^| |\*)$(basename "${url}")\$|^[0-9a-f]{64}\$" | head -n1 | awk '{print $1}'); else want=${sum}; fi
 echo "${want}  ${file}" | sha256sum -c --quiet - || { rm -f "${file}"; echo "checksum mismatch for ${url}" >&2; exit 1; }
}
fetch "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz.sha256sum" "helm-${HELM_VERSION}.tgz"
tar -xzf "${CACHE}/helm-${HELM_VERSION}.tgz" -C "${OUT}/tools" --strip-components=1 linux-amd64/helm
fetch "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl.sha256" "kubectl-${KUBECTL_VERSION}"
install -m 755 "${CACHE}/kubectl-${KUBECTL_VERSION}" "${OUT}/tools/kubectl"
fetch "https://github.com/google/go-containerregistry/releases/download/${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz" \
      "https://github.com/google/go-containerregistry/releases/download/${CRANE_VERSION}/checksums.txt" "crane-${CRANE_VERSION}.tgz"
tar -xzf "${CACHE}/crane-${CRANE_VERSION}.tgz" -C "${OUT}/tools" crane
fetch "https://github.com/jqlang/jq/releases/download/${JQ_VERSION}/jq-linux-amd64" "https://github.com/jqlang/jq/releases/download/${JQ_VERSION}/sha256sum.txt" "jq-${JQ_VERSION}"
install -m 755 "${CACHE}/jq-${JQ_VERSION}" "${OUT}/tools/jq"
for t in helm kubectl crane jq; do "${OUT}/tools/${t}" version >/dev/null 2>&1 || "${OUT}/tools/${t}" --version >/dev/null; echo "  ${t}"; done

CRANE="${OUT}/tools/crane"
list="${OUT}/images/images.txt"
echo "# <file in images/>  <path under \$REGISTRY>   (./install images pushes each file there)" > "${list}"
add_public() {   # add_public <image ref>: pulled for ${PLATFORM} straight from its registry
 local ref=$1 path file
 path=${ref#*/}                          # drop the registry host: ghcr.io/a/b:t -> a/b:t
 file=$(echo "${path}" | tr '/:' '__').tar
 [[ ${images} -eq 1 ]] && { "${CRANE}" pull --platform "${PLATFORM}" "${ref}" "${OUT}/images/${file}"; echo "  ${ref}"; }
 echo "${file} ${path}" >> "${list}"
}
add_built() {   # add_built <local image> (built here with docker)
 local ref=$1 file
 file=$(echo "${ref}" | tr '/:' '__').tar
 [[ ${images} -eq 1 ]] && { docker save -o "${OUT}/images/${file}" "${ref}"; echo "  ${ref} (built)"; }
 echo "${file} ${ref}" >> "${list}"
}
if [[ ${images} -eq 1 ]]; then
 say "building images"
 mkdir -p images/coder/extra-providers; rm -f images/coder/extra-providers/*.tf
 if [[ -n "${EXTRA_PROVIDERS:-}" ]]; then
  { echo "terraform {"; echo "  required_providers {"
    for p in ${EXTRA_PROVIDERS}; do src=${p%%:*}; v=${p#*:}; [[ "${p}" == *:* ]] || v=""
     echo "    $(echo "${src}" | tr '/._' '---') = { source = \"${src}\"$( [[ -n "${v}" ]] && echo ", version = \"${v}\"") }"; done
    echo "  }"; echo "}"; } > images/coder/extra-providers/providers.tf
  echo "  extra providers: ${EXTRA_PROVIDERS}"
 fi
 docker build --platform "${PLATFORM}" -t "coder-platform/workspace:${WORKSPACE_TAG}" images/workspace
 docker build --platform "${PLATFORM}" --build-arg "CODER_VERSION=${CODER_VERSION}" -t "coder-platform/coder:v${CODER_VERSION}" -f images/coder/Dockerfile .
 # The workspace template in the chart and the provider mirror in the image must agree: prove it offline.
 tfdir=$(mktemp -d); trap 'rm -rf "${tfdir}"' EXIT
 sed 's/@@[A-Z_]*@@/x/g' "${CHART_DIR}/files/workspace/main.tf" > "${tfdir}/main.tf"; cp "${CHART_DIR}/files/workspace/certificates.tf" "${tfdir}/"
 chmod -R a+rwX "${tfdir}"
 docker run --rm --network none -v "${tfdir}:/w" -w /w --entrypoint sh "coder-platform/coder:v${CODER_VERSION}" \
  -c 'terraform init -input=false >/dev/null && terraform validate -no-color' || { echo "the template doesn't init offline with the image's provider mirror" >&2; exit 1; }
fi
docker run --rm --entrypoint sh "coder-platform/coder:v${CODER_VERSION}" -c 'cd /opt/terraform/plugins && find . -name "*_linux_amd64.zip"' \
 | sed -E 's#^\./##; s#/terraform-provider-[^_]+_([^_]+)_linux_amd64\.zip$# \1#' | sort > "${OUT}/providers.txt" 2>/dev/null || true
say "images"
add_built "coder-platform/coder:v${CODER_VERSION}"
add_built "coder-platform/workspace:${WORKSPACE_TAG}"
add_public "${CNPG_OPERATOR}"
add_public "${POSTGRES}"
add_public "${PYTHON}"
add_public "${NGINX}"

say "archive"
(cd "${OUT}" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS)
tar -C dist -czf "dist/${NAME}.tar.gz" "${NAME}"
(cd dist && sha256sum "${NAME}.tar.gz" > "${NAME}.tar.gz.sha256")
cp INSTALL-HELM.txt INSTALL-ARGOCD.txt UPGRADE-EXISTING.txt dist/   # the gold directory = the tarball, its .sha256 and these two guides
[[ ${keep} -eq 1 ]] || rm -rf "${OUT}"
ls -lh "dist/${NAME}.tar.gz" | awk '{print "  " $NF "  " $5}'
echo "  sha256 $(cut -c1-64 "dist/${NAME}.tar.gz.sha256")"
