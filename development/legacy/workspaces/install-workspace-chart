#!/bin/bash
# Installs/upgrades the coder-workspace chart into the coder namespace and pushes the workspace template.
#
# The Coder session token for the push is taken from, in order: $CODER_SESSION_TOKEN, the coder CLI's session when it
# is logged in to this Coder (coder login https://coder.xxx.com), or ../util/fetch-coder-token. It is handed to the
# push Job through a Secret that exists only during the install; it never goes into Helm values (stored in the
# release record) or into the Job's spec.
set -euo pipefail
cd "$(dirname "$0")"

NAMESPACE="coder"
CODER_WORKSPACE_CHART_NAME="coder-workspace"
CODER_WORKSPACE_CHART_PATH="./workspace-chart"
TOKEN_SECRET="coder-workspace-push-token"
CODER_URL=$(../util/fetch-coder-domain)

token="${CODER_SESSION_TOKEN:-}"
if [[ -z "$token" ]]; then
  cfg="${CODER_CONFIG_DIR:-$HOME/.config/coderv2}"
  if [[ -s "$cfg/session" && "$(cat "$cfg/url" 2>/dev/null)" == "${CODER_URL%/}" ]]; then
    token=$(<"$cfg/session")
  else
    token=$(../util/fetch-coder-token) || { echo "No Coder token: set CODER_SESSION_TOKEN or run: coder login ${CODER_URL}" >&2; exit 1; }
  fi
fi

cleanup() { kubectl -n "$NAMESPACE" delete secret "$TOKEN_SECRET" --ignore-not-found >/dev/null; }
trap cleanup EXIT
kubectl -n "$NAMESPACE" create secret generic "$TOKEN_SECRET" --from-literal=token="$token" \
  --dry-run=client -o yaml | kubectl apply -f - >/dev/null

helm upgrade --install "${CODER_WORKSPACE_CHART_NAME}" "${CODER_WORKSPACE_CHART_PATH}" \
  --namespace "$NAMESPACE" \
  --set namespace="$NAMESPACE" \
  --set coder.url="${CODER_URL}" \
  --set coder.tokenSecret="$TOKEN_SECRET" \
  --wait-for-jobs --timeout 10m
