#!/bin/bash
# Removes the Coder banner and PROVES Coder is back to its stock state. Coder's own Deployment, Service,
# HTTPRoute and database are never touched: the chart only ever adds objects of its own, next to them.
#
#   ./uninstall-banner-chart                   remove the banner chart
#   ./uninstall-banner-chart --remove-plugin   also revert Traefik's rewrite-body plugin setting
#   ./uninstall-banner-chart --keep-traefik    (default) leave Traefik as it is
#
# Installed through Argo CD instead? Delete the Application (its finalizer removes exactly what it created):
#   kubectl -n argocd delete application coder-banner
# and then run this script with --verify-only.
set -euo pipefail
cd "$(dirname "$0")"
# fetch-coder-domain sits next to the scripts in a bundle, and in ../util in the repository.
FETCH_DOMAIN=./fetch-coder-domain; [[ -x "${FETCH_DOMAIN}" ]] || FETCH_DOMAIN=../util/fetch-coder-domain

CODER_NAMESPACE="${CODER_NAMESPACE:-coder}"
CODER_DEPLOYMENT="${CODER_DEPLOYMENT:-${CODER_SERVICE:-coder}}"   # Coder's Deployment
CODER_SERVICE="${CODER_SERVICE:-coder}"
remove_plugin=0; verify_only=0
for arg in "$@"; do
 case "${arg}" in
  --remove-plugin) remove_plugin=1 ;;
  --keep-traefik) remove_plugin=0 ;;
  --verify-only) verify_only=1 ;;
  *) echo "usage: $0 [--remove-plugin] [--verify-only]" >&2; exit 2 ;;
 esac
done

fail=0
ok()   { echo "  OK    $*"; }
bad()  { echo "  FAIL  $*"; fail=1; }
info() { echo "  --    $*"; }

# 1. Remove the release.
if [[ ${verify_only} -eq 0 ]]; then
 if helm status coder-banner -n "${CODER_NAMESPACE}" >/dev/null 2>&1; then
  echo "Removing the coder-banner release..."
  helm uninstall coder-banner -n "${CODER_NAMESPACE}" --wait
 elif kubectl -n argocd get application coder-banner >/dev/null 2>&1; then
  echo "coder-banner is managed by Argo CD - delete the Application instead:  kubectl -n argocd delete application coder-banner" >&2
  exit 1
 else
  info "no coder-banner Helm release found (already removed?) - verifying the cluster state"
 fi
fi

# 2. Optionally revert the Traefik plugin change (only once nothing uses the plugin any more).
if [[ ${remove_plugin} -eq 1 && ${verify_only} -eq 0 ]]; then
 echo "Reverting Traefik's plugin setting..."
 ./traefik-plugin/disable-plugin
fi

# 3. Verify. Traefik notices deleted routes a few seconds later and pods take their grace period to stop, so
#    each check is given up to a minute to converge before it counts as a failure.
wait_until() { local tries=0; until "$@"; do tries=$((tries+1)); [[ ${tries} -ge 30 ]] && return 1; sleep 2; done; }
echo "Verifying..."
kubectl -n "${CODER_NAMESPACE}" wait --for=delete pod -l app.kubernetes.io/name=coder-banner --timeout=90s >/dev/null 2>&1 || true

left=$(kubectl -n "${CODER_NAMESPACE}" get \
 deployments,services,configmaps,serviceaccounts,roles,rolebindings,httproutes.gateway.networking.k8s.io,middlewares.traefik.io \
 -l app.kubernetes.io/name=coder-banner -o name 2>/dev/null || true)
if [[ -z "${left}" ]]; then ok "no coder-banner objects remain in namespace ${CODER_NAMESPACE}"; else bad "leftovers:"; echo "${left}" | sed 's/^/          /'; fi

if [[ -n "$(kubectl -n "${CODER_NAMESPACE}" get pods -l app.kubernetes.io/name=coder-banner -o name 2>/dev/null)" ]]; then bad "banner pods still present"; else ok "no banner pods"; fi

kubectl -n "${CODER_NAMESPACE}" get deployment "${CODER_DEPLOYMENT}" >/dev/null 2>&1 && ok "Coder Deployment untouched and present" || bad "Coder Deployment missing"
kubectl -n "${CODER_NAMESPACE}" get service "${CODER_SERVICE}" >/dev/null 2>&1 && ok "Coder Service present" || bad "Coder Service missing"
kubectl -n "${CODER_NAMESPACE}" get httproute coder >/dev/null 2>&1 && ok "Coder's own HTTPRoute present" || info "no HTTPRoute named 'coder' (fine if Coder is exposed another way)"
[[ "$(kubectl -n "${CODER_NAMESPACE}" get deployment "${CODER_DEPLOYMENT}" -o jsonpath='{.status.availableReplicas}' 2>/dev/null)" -ge 1 ]] && ok "Coder is available" || bad "Coder has no available replicas"

# What a browser gets, if we can reach Coder from here.
if CODER_URL=$("${FETCH_DOMAIN}" 2>/dev/null) && [[ -n "${CODER_URL}" ]]; then
 scratch="$(mktemp -d)"; trap 'rm -rf "${scratch}"' EXIT
 . ./coder-ca.sh "${scratch}"
 curl_opts=(-sS -m 20 "${CA_OPTS[@]}")
 fetch_page() { curl "${curl_opts[@]}" -H "Accept: text/html" "${CODER_URL}/login" 2>/dev/null; }
 page_is_stock() { page=$(fetch_page) && [[ -n "${page}" ]] && ! grep -q '__banner' <<<"${page}"; }
 if [[ -z "$(fetch_page || true)" ]]; then
  info "could not fetch ${CODER_URL}/login from here - skipped the page checks"
 else
  wait_until page_is_stock && ok "login page is stock (no banner loader)" || bad "the login page still references /__banner"
  entry=$(grep -oE '/assets/index-[A-Za-z0-9_-]+\.js' <<<"${page}" | head -1)
  if [[ -n "${entry}" ]]; then
   js_is_stock() { [[ "$(curl "${curl_opts[@]}" --compressed "${CODER_URL}${entry}" 2>/dev/null | grep -c 'Codernauts' || true)" -ge 1 ]]; }
   wait_until js_is_stock && ok "Coder's JavaScript is stock (user menu shows Codernauts again)" || bad "Coder's JavaScript is still rewritten"
  fi
  ctype=$(curl "${curl_opts[@]}" -o /dev/null -w '%{content_type}' "${CODER_URL}/__banner/banner.js" 2>/dev/null || true)
  if [[ "${ctype}" == *javascript* ]]; then bad "/__banner/banner.js is still being served by the banner"; else ok "/__banner/* is no longer served by the banner (Coder answers: ${ctype:-n/a})"; fi
 fi
fi

if [[ ${fail} -eq 0 ]]; then
 cat <<'MSG'

Coder is back to its stock state.
Note: browsers that already loaded the rewritten Coder app keep it cached (Coder marks it immutable), so
their user menu still says "Banner" until a hard refresh (Ctrl+Shift+R) - it links to a page that no longer
exists. New visitors and private windows are unaffected.
MSG
else
 echo; echo "Something was not removed cleanly - see the FAIL lines above." >&2
fi
exit ${fail}
