#!/bin/bash
# Change the banner's chart DEFAULTS from the command line. Admins normally use the admin page
# (https://coder.xxx.com/__banner/admin) instead; anything published there takes precedence over these
# defaults until "use the chart defaults" is pressed on that page.
#   ./banner-set --message "Upgrade tonight 22:00 UTC" --level warning
#   ./banner-set --message "Coder is back" --level success --link-text "Notes" --link-url https://example.com
#   ./banner-set --off        # hide the default banner        ./banner-set --on   # show it again
#   ./banner-set --effect typewriter            # text effect: none typewriter fade rise wave bounce flip shake pulse rainbow
#   ./banner-set --effect wave --repeat         # keep repeating (--no-repeat: play once each time the banner appears)
set -euo pipefail
cd "$(dirname "$0")"
. ./chart-path.sh

args=()
while [[ $# -gt 0 ]]; do
 case "$1" in
  --message) args+=(--set-string "banner.message=$2"); shift 2 ;;
  --title) args+=(--set-string "banner.title=$2"); shift 2 ;;
  --level) args+=(--set-string "banner.level=$2"); shift 2 ;;
  --link-text) args+=(--set-string "banner.linkText=$2"); shift 2 ;;
  --link-url) args+=(--set-string "banner.linkUrl=$2"); shift 2 ;;
  --no-dismiss) args+=(--set banner.dismissible=false); shift ;;
  --effect) args+=(--set-string "banner.effect=$2"); shift 2 ;;
  --repeat) args+=(--set banner.repeat=true); shift ;;
  --no-repeat) args+=(--set banner.repeat=false); shift ;;
  --off) args+=(--set banner.enabled=false); shift ;;
  --on) args+=(--set banner.enabled=true); shift ;;
  *) echo "unknown option: $1" >&2; exit 1 ;;
 esac
done

helm upgrade coder-banner "${CHART}" --namespace "${CODER_NAMESPACE:-coder}" --reset-then-reuse-values "${args[@]}"
