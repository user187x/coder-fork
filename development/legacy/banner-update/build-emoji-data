#!/usr/bin/env python3
"""Generates the emoji data file used by the banner admin page's emoji picker.

  ./build-emoji-data                    # downloads emojibase-data with npm (needs internet, once)
  ./build-emoji-data --from DIR         # or use an already unpacked emojibase-data package
  ./build-emoji-data --max-version 13   # only emoji up to this Unicode Emoji version (default 14)

Output (committed to the repo, so nothing has to be downloaded to build or install the chart):
  banner-chart/files/emoji/emoji-data.js   ONE self-contained script: window.CoderBannerEmoji = {...}
  banner-chart/files/emoji/LICENSE-emojibase.md

Why not a picker library: they either need the data as a separate download, or inject <style> elements that the
admin page's strict Content-Security-Policy blocks, or are too big for one ConfigMap under Argo CD. The picker UI is
files/emoji-picker.js; this file is only the data, from the MIT-licensed `emojibase-data` package (labels and keywords
derived from Unicode CLDR).

Left out on purpose: skin-tone variants and the "components" group (only variations of other emoji), and country
flags (of no use in an announcement). Emoji newer than --max-version are left out because older operating systems draw
them as empty boxes.
"""
import argparse
import glob
import json
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
OUT_DIR = os.path.join(HERE, "banner-chart", "files", "emoji")
SKIP_GROUPS = {2, 9}  # components, flags
MAX_TAGS = 6


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--from", dest="src", help="directory of an unpacked emojibase-data package")
    ap.add_argument("--max-version", type=float, default=14.0)
    ap.add_argument("--package-version", default="17.0.0", help="emojibase-data version to download")
    args = ap.parse_args()

    tmp = None
    src = args.src
    if not src:
        tmp = tempfile.mkdtemp()
        subprocess.run(["npm", "pack", "emojibase-data@" + args.package_version, "--silent"], cwd=tmp, check=True, stdout=subprocess.DEVNULL)
        subprocess.run(["tar", "xzf", glob.glob(os.path.join(tmp, "emojibase-data-*.tgz"))[0], "-C", tmp], check=True)
        src = os.path.join(tmp, "package")
    with open(os.path.join(src, "package.json")) as f:
        meta = json.load(f)
    with open(os.path.join(src, "en", "data.json")) as f:
        data = json.load(f)
    with open(os.path.join(src, "en", "messages.json")) as f:
        messages = json.load(f)

    groups = [g for g in sorted(messages["groups"], key=lambda g: g["order"]) if g["order"] not in SKIP_GROUPS]
    index = {g["order"]: i for i, g in enumerate(groups)}
    rows = []
    for e in sorted((e for e in data if e.get("group") in index and e["version"] <= args.max_version), key=lambda e: e["order"]):
        label = e["label"]
        words = [t for t in e.get("tags", []) if t not in label.split()][:MAX_TAGS]
        rows.append([index[e["group"]], e["emoji"], label, " ".join(words)])

    payload = {
        "source": "emojibase-data %s (MIT); labels and keywords from Unicode CLDR" % meta["version"],
        "maxVersion": args.max_version,
        "groups": [g["message"] for g in groups],
        "emoji": rows,
    }
    os.makedirs(OUT_DIR, exist_ok=True)
    out = os.path.join(OUT_DIR, "emoji-data.js")
    with open(out, "w", encoding="utf-8") as f:
        f.write(
            "/* Emoji data for the banner admin page (generated by build-emoji-data; do not edit).\n"
            " * Source: %s. Emoji up to Unicode Emoji %s. See LICENSE-emojibase.md. */\n" % (payload["source"], args.max_version)
        )
        f.write("window.CoderBannerEmoji=" + json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + ";\n")
    with open(os.path.join(src, "LICENSE"), encoding="utf-8") as f:
        mit = f.read().strip()
    with open(os.path.join(OUT_DIR, "LICENSE-emojibase.md"), "w", encoding="utf-8") as f:
        f.write(
            "# Emoji data licence\n\n"
            "The file `emoji-data.js` is derived from the `emojibase-data` package (https://emojibase.dev), which is\n"
            "distributed under the MIT licence below. The emoji names and keywords in it originate from the Unicode\n"
            "Common Locale Data Repository (CLDR), Copyright (c) Unicode, Inc., used under the Unicode License v3\n"
            "(https://www.unicode.org/license.txt).\n\n"
            "```\n" + mit + "\n```\n"
        )
    print("wrote %s: %d emoji in %d groups, %d bytes (%s)" % (os.path.relpath(out), len(rows), len(groups), os.path.getsize(out), payload["source"]))
    if tmp:
        subprocess.run(["rm", "-rf", tmp])


if __name__ == "__main__":
    sys.exit(main())
