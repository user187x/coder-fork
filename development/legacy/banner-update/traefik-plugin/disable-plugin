#!/bin/bash
# Reverts enable-plugin: removes the plugin's argument(s), mount and volume from the RUNNING Traefik Deployment (an
# additive patch in reverse: nothing else is changed, no chart is needed) and deletes the plugin ConfigMap.
# The Gateway, the CRDs, all routes and Middlewares are untouched.
#   ./disable-plugin [--diff-only]
set -euo pipefail
cd "$(dirname "$0")"
. ./plugin-lib.sh

[[ "${1:-}" == "--diff-only" ]] && diff_only=1 || diff_only=0
[[ -z "${1:-}" || "${1:-}" == "--diff-only" ]] || { echo "usage: $0 [--diff-only]" >&2; exit 2; }

# Nothing may still use the plugin when it is switched off, or Traefik will drop those routers.
users=$(kubectl get middlewares.traefik.io -A -o jsonpath='{range .items[?(@.spec.plugin)]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' 2>/dev/null || true)
if [[ -n "${users}" ]]; then
 echo "WARNING: these Traefik Middlewares still use a plugin (remove them first, e.g. ./uninstall-banner-chart):" >&2
 sed 's/^/  /' <<<"${users}" >&2
 [[ ${diff_only} -eq 1 ]] || exit 1
fi

load_live || exit 1
guard_target || exit $?
plan_disable
show_plugin_patch disable || exit 1
[[ ${diff_only} -eq 1 ]] && exit 0
apply_plugin_patch disable || { echo "Disabling the plugin failed: Traefik is back on its previous configuration." >&2; exit 1; }
echo "Traefik no longer loads the rewrite-body plugin (it is otherwise exactly as it was)."
