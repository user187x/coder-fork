#!/usr/bin/env python3
"""Regenerates rewrite-body-plugin-airgap.yaml from plugin-src/.

The Traefik chart's `inlinePlugin` type ships the plugin as a ConfigMap and mounts it where Traefik looks for
local plugins, so nothing is downloaded at startup. Usage:  ./gen-airgap-plugin-values > rewrite-body-plugin-airgap.yaml
"""
import os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
SRC = os.path.join(HERE, "plugin-src")
FILES = [".traefik.yml", "go.mod", "rewritebody.go"]  # all Traefik needs at runtime
MODULE = "github.com/traefik/plugin-rewritebody"

out = [
    "# Enables the Traefik \"rewrite-body\" plugin WITHOUT internet access (generated - do not edit by hand;",
    "# regenerate with ./gen-airgap-plugin-values from plugin-src/). Use instead of rewrite-body-plugin.yaml.",
    "# The key under localPlugins must match `plugin.name` in banner-chart/values.yaml.",
    "experimental:",
    "  localPlugins:",
    "    rewrite-body:",
    "      moduleName: " + MODULE,
    "      mountPath: /plugins-local/src/" + MODULE,
    "      type: inlinePlugin",
    "      source:",
]
for name in FILES:
    body = open(os.path.join(SRC, name)).read().rstrip("\n")
    out.append("        %s: |" % name)
    out.extend(("          " + line) if line else "" for line in body.split("\n"))
sys.stdout.write("\n".join(out) + "\n")
