     -e "s|@@HIDDEN_LINKS@@|${HIDDEN_JSON}|g" -e "s|@@VIEW_PATH@@|${VIEW_PATH}|g" -e "s|@@VIEW_LABEL@@|${VIEW_LABEL}|g" \
     -e "s|@@HOST@@|${HOST}|g" -e "s|@@GATEWAY_NAME@@|${GATEWAY_NAME}|g" -e "s|@@GATEWAY_NAMESPACE@@|${GATEWAY_NS}|g" \
     -e "s|@@CODER_SERVICE@@|${CODER_SERVICE}|g" -e "s|@@CODER_PORT@@|${CODER_PORT}|g" -e "s|@@IMAGE@@|${IMAGE}|g" \
     -e "s|@@CHECKSUM@@|${CHECKSUM}|g" -e "s|@@BANNER_URL@@|${BANNER_URL}|g" -e "s|@@ADMIN_ROLES@@|${ADMIN_ROLES}|g" \
     -e "s|^@@STORAGE_CLASS@@\$|${storage_line}|" -e "s|@@CODER_URL@@|${CODER_URL}|g" \
     -e "s|@@KEYCLOAK_NAMESPACE@@|${KEYCLOAK_NAMESPACE}|g" -e "s|@@KEYCLOAK_ADMIN_SECRET@@|${KEYCLOAK_ADMIN_SECRET}|g" \
     -e "s|@@ARGOCD_NAMESPACE@@|${ARGOCD_NAMESPACE}|g" -e "s|@@ARGOCD_APP@@|${ARGOCD_APP}|g" \
     -e "s|@@CA_SOURCE_SECRET@@|${CA_SOURCE_SECRET}|g" -e "s|@@WORKSPACE_NAMESPACE@@|${WORKSPACE_NAMESPACE}|g" \
     -e "s|@@CODER_DB_SECRET@@|${CODER_DB_SECRET}|g" -e "s|@@CODER_DB_CA_SECRET@@|${CODER_DB_CA_SECRET}|g" \
     -e "s|@@CODER_DB_SECRET_KEY@@|${CODER_DB_SECRET_KEY:-uri}|g" -e "s|@@ATTACHED@@|false|g" \
     -e "s|@@OIDC_SECRET_NAME@@|${OIDC_SECRET_NAME}|g" -e "s|@@CODER_CERT_SECRETS@@|${CODER_CERT_SECRETS}|g" \
     -e "s|@@LOGS_DB_IMAGE@@|${LOGS_DB_IMAGE}|g" \
     -e "s|^@@BANNER_LOADER@@\$|${banner_line}|" -e "s|^@@SECTION_NAME@@\$|${section_line}|" "$1" \
  | awk -v items="${STATIC_ITEMS}" '$0 == "@@STATIC_ITEMS@@" { printf "%s", items; next } { print }' \
  | sed -e '/^$/d'
}

default_file() {   # default_file <logo|avatar>: resources/defaults/<kind>.<ext>, or nothing
 local f
 for f in "${RES}/defaults/$1".{png,jpg,jpeg,gif,webp,svg}; do
  [[ -f "${f}" ]] || continue
  [[ "$1" == avatar && "${f}" == *.svg ]] && die "${f}: an avatar can't be SVG (PNG, JPEG, GIF or WebP)"
  [[ $(stat -c%s "${f}") -le ${DEFAULT_MAX_BYTES} ]] || die "${f} is $(stat -c%s "${f}") bytes: default images must be at most ${DEFAULT_MAX_BYTES} (one ConfigMap each)"
  echo "${f}"; return
 done
}

render_all() {
