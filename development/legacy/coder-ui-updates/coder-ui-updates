Some changes are not applied; Coder shows its stock item for each FAIL above (nothing is broken). This is expected
after a Coder upgrade that changed the minified code. Compare the regexes in resources/middlewares.yaml with it:
  curl -s --compressed ${CODER_URL}${entry} | grep -o '.\{300\}support_links.\{300\}'
MSG
 fi
 return ${status}
}

refresh_hint() {
 cat <<MSG

The rewritten JavaScript is now cached for 5 minutes, so later updates reach browsers on their own. A browser that
cached it before this version (Coder marks it cacheable for a year) needs clearing once. Once per browser, open:
  ${CODER_URL}/__coder-ui/refresh      (clears this site's cache and returns to the dashboard; or hard-reload)
MSG
}

# ---------------------------------------------------------------- actions
case "${ACTION}" in
 render)
  gather; render_all
  for f in "${WORK}"/*.yaml; do echo "---"; echo "# ${f##*/}"; cat "${f}"; done
  ;;

 apply)
  gather; render_all
  echo "Coder:   ${CODER_URL}  (Service ${NS}/${CODER_SERVICE}:${CODER_PORT})"
  echo "Gateway: ${GATEWAY_NS}/${GATEWAY_NAME}${SECTION_NAME:+ listener ${SECTION_NAME}}   plugin: ${PLUGIN}"
  echo "Service: ${IMAGE}   admins: ${ADMIN_ROLES}"
  echo "Logo: Coder's database ${CODER_DB_CLUSTER} (Secret ${CODER_DB_SECRET})   Monitoring: pods in ${WORKSPACE_NAMESPACE}, log buffer ${LOGS_DB_IMAGE}"
  echo "Keycloak view: Keycloak ${KEYCLOAK_NAMESPACE:-not found} (admin Secret ${KEYCLOAK_ADMIN_SECRET}), Coder's settings in ${ARGOCD_APP:+Argo CD Application ${ARGOCD_NAMESPACE}/}${ARGOCD_APP:-(not Argo CD: read-only)}"
  [[ ${NATIVE} -eq 1 ]] && echo "Dashboard: Coder's platform build ($(k get deployment "${CODER_SERVICE}" -o jsonpath='{.spec.template.spec.containers[0].image}')) has the add-ons built in: nothing is rewritten, only /__coder-ui/ is routed"
  if [[ ${NATIVE} -eq 1 ]]; then echo "Banner:  shown by the dashboard itself (the coder-banner route's loader is kept off Coder's pages)"
  elif [[ ${BANNER_PRESENT} -eq 1 ]]; then echo "Banner:  coder-banner found; page loads keep its loader (its user-menu item is removed)"
  else echo "Banner:  coder-banner is not installed; the ${VIEW_LABEL} view will say the banner service is unavailable"; fi
  dl=$(default_file logo); da=$(default_file avatar)
  echo "Defaults: logo $([[ -n "${dl}" ]] && echo "${dl##*/} (a fresh database starts with it)" || echo none)," \
   "avatar $([[ -n "${da}" ]] && echo "${da##*/} (users without a picture)" || echo none)"

  ca_opts
  pre=$(curl -sS "${CA_OPTS[@]}" -o /dev/null -w '%{http_code}' "${CODER_URL}/login" 2>/dev/null || echo 000)

  # The first version ran nginx with a RollingUpdate Deployment; the service's volume needs Recreate, which Kubernetes
  # refuses to switch to in place. Replace that Deployment once (only /__coder-ui/ is briefly away, not Coder).
  strategy=$(k get deployment coder-ui-updates -o jsonpath='{.spec.strategy.type}' 2>/dev/null || true)
  echo "Validating the manifests with the API server..."
  if [[ "${strategy}" == RollingUpdate ]]; then
   files=()
   for f in "${WORK}"/1[0-9]-*.yaml "${WORK}"/30-middlewares.yaml "${WORK}/40-httproute.yaml"; do [[ -f "${f}" ]] && files+=(-f "${f}"); done
   kubectl apply --server-side --field-manager=coder-ui-updates --dry-run=server "${files[@]}" >/dev/null
  else
   kubectl apply --server-side --field-manager=coder-ui-updates --dry-run=server -f "${WORK}" >/dev/null
  fi

  # The temporary log database's password: made once (hex, so it is safe inside a connection URL), then reused.
  if ! k get secret coder-ui-logs-db >/dev/null 2>&1; then
   [[ "${ACTION}" == apply ]] && k create secret generic coder-ui-logs-db --from-literal=password="$(od -An -tx1 -N24 /dev/urandom | tr -d ' \n')" >/dev/null
   k label secret coder-ui-logs-db app.kubernetes.io/name=coder-ui-updates app.kubernetes.io/part-of=coder "${MANAGED}" >/dev/null
  fi
  echo "Applying..."
  if [[ "${strategy}" == RollingUpdate ]]; then
   echo "Replacing the previous (nginx) Deployment with the service..."
   k delete deployment coder-ui-updates --wait=true
  fi
  # Files first, route last: the route never points at a middleware or backend that does not exist yet.
  files=()
  for f in "${WORK}"/1[0-9]-*.yaml "${WORK}/20-ui-service.yaml"; do files+=(-f "${f}"); done
  kubectl apply --server-side --field-manager=coder-ui-updates "${files[@]}"
  for kind in logo avatar; do   # a default image taken out of resources/defaults/ goes from the cluster too
   [[ -f "${WORK}/11-default-${kind}.yaml" ]] || k delete configmap "coder-ui-updates-default-${kind}" --ignore-not-found >/dev/null
  done
  k rollout status deployment/coder-ui-updates --timeout=180s
  [[ ${NATIVE} -eq 1 ]] || kubectl apply --server-side --field-manager=coder-ui-updates -f "${WORK}/30-middlewares.yaml"
  kubectl apply --server-side --field-manager=coder-ui-updates -f "${WORK}/40-httproute.yaml"
  if [[ ${NATIVE} -eq 1 ]]; then   # the route no longer uses them (a switch from an upstream Coder)
   k delete middlewares.traefik.io -l app.kubernetes.io/name=coder-ui-updates --ignore-not-found
  fi

  if [[ "${pre}" != 200 ]]; then
   echo "Coder was not reachable from here before applying (HTTP ${pre}), so the result cannot be checked from here."
   echo "Run ./coder-ui-updates verify from a machine that can reach ${CODER_URL}."
   refresh_hint; exit 0
  fi

  echo "Waiting for Traefik to load the route, then checking what browsers get..."
  for _ in $(seq 1 24); do
   code=$(fetch "/__coder-ui/healthz" "${WORK}/health")
   [[ "${code}" == 200 ]] && break
   sleep 5
  done
  sleep 3   # the route's three rules arrive in one configuration update; give Traefik a moment beyond the first
  echo
  if verify; then result=0; else result=$?; fi
  if [[ ${VERIFY_BROKEN} -eq 1 ]]; then
   echo "Rolling back the route so Coder's own JavaScript is served again..." >&2
   k delete httproute coder-ui-updates --ignore-not-found
   exit 1
  fi
  refresh_hint
  exit "${result}"
  ;;

 verify)
  validate_settings
  CODER_URL=$(coder_url); [[ -n "${CODER_URL}" ]] || die "could not read CODER_ACCESS_URL (set CODER_URL)"
  detect_native
  verify
  ;;

 remove)
  CODER_URL=$(coder_url)
  # Route first, so the chunks are served untouched before anything they depend on goes away.
  k delete httproute -l "${MANAGED}" --ignore-not-found
  k delete middleware.traefik.io -l "${MANAGED}" --ignore-not-found
  k delete deployment,service,configmap,secret,rolebinding,role,serviceaccount -l "${MANAGED}" --ignore-not-found
  # The Roles in Keycloak's and Argo CD's namespaces, wherever they were created.
  kubectl delete rolebinding,role -A -l "${MANAGED}" --ignore-not-found
  kubectl delete clusterrolebinding,clusterrole -l "${MANAGED}" --ignore-not-found
  if [[ "${2:-}" == --purge ]]; then
   k delete pvc -l "${MANAGED}" --ignore-not-found
   # The logo lives in Coder's own database: drop only this tool's schema, through the CloudNativePG primary's local psql.
   db_secret=$(k get deployment "${CODER_SERVICE}" -o jsonpath="{.spec.template.spec.containers[0].env[?(@.name=='CODER_PG_CONNECTION_URL')].valueFrom.secretKeyRef.name}" 2>/dev/null || true)
   cluster="${CODER_DB_CLUSTER:-${db_secret%-app}}"
   primary=$(k get cluster.postgresql.cnpg.io "${cluster}" -o jsonpath='{.status.currentPrimary}' 2>/dev/null || true)
   dbname=$(k get cluster.postgresql.cnpg.io "${cluster}" -o jsonpath='{.spec.bootstrap.initdb.database}' 2>/dev/null || true)
   if [[ -n "${primary}" ]]; then
    k exec "${primary}" -c postgres -- psql -q -d "${dbname:-app}" -c 'DROP SCHEMA IF EXISTS coder_ui_updates CASCADE' \
     && echo "Dropped schema coder_ui_updates (the custom logo) from ${cluster}." || echo "warning: could not drop schema coder_ui_updates from ${cluster}" >&2
   fi
   echo "Removed, including the announcement receipts and the logo. Coder's stock menus and sidebar are back."
  else
   echo "Removed. Coder's stock menus and sidebar are back."
   echo "Kept: the announcement receipts (PVC ${NS}/coder-ui-updates-data) and the logo (schema coder_ui_updates in"
   echo "Coder's database); './coder-ui-updates remove --purge' deletes them too."
  fi
  [[ -n "${CODER_URL}" ]] && cat <<MSG
Browsers that cached the modified JavaScript keep it until their cache is cleared: hard-reload Coder once
(the ${CODER_URL}/__coder-ui/refresh shortcut is gone together with everything else).
MSG
  ;;

 export-defaults)
  AVATAR_USER="${2:-${AVATAR_USER:-}}"   # export-defaults <username>, or AVATAR_USER in the environment
  # What this Coder shows now becomes the default images (resources/defaults/). Read through the Gateway from the
  # same public URLs every page loads (boot.js, the logo, the avatars); nothing in the cluster is changed.
  command -v jq >/dev/null || die "jq is required"
  CODER_URL=$(coder_url); [[ -n "${CODER_URL}" ]] || die "could not read CODER_ACCESS_URL (set CODER_URL)"
  ca_opts
  save() {   # save <logo|avatar> <path on Coder's host>: resources/defaults/<kind>.<ext>, replacing the previous one
   local type ext size
   type=$(curl -sS --fail "${CA_OPTS[@]}" -o "${WORK}/$1.img" -w '%{content_type}' "${CODER_URL}$2") || die "could not download ${CODER_URL}$2"
   case "${type%%;*}" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/gif) ext=gif ;; image/webp) ext=webp ;;
    image/svg+xml) ext=svg ;; *) die "${CODER_URL}$2 is '${type}', not a PNG, JPEG, GIF, WebP or SVG image" ;; esac
   size=$(stat -c%s "${WORK}/$1.img")
   [[ ${size} -le ${DEFAULT_MAX_BYTES} ]] || die "the $1 is ${size} bytes; a default image can be at most ${DEFAULT_MAX_BYTES} (one ConfigMap each): upload a smaller one first"
   mkdir -p "${RES}/defaults"
   rm -f "${RES}/defaults/$1".{png,jpg,jpeg,gif,webp,svg}
   cp "${WORK}/$1.img" "${RES}/defaults/$1.${ext}"
   echo "saved resources/defaults/$1.${ext} (${size} bytes, ${type%%;*})"
  }
  code=$(fetch /__coder-ui/api/logo "${WORK}/logo.json")
  [[ "${code}" == 200 ]] || die "${CODER_URL}/__coder-ui/api/logo answered HTTP ${code}: is coder-ui-updates applied there?"
  url=$(jq -r '.url // empty' "${WORK}/logo.json")
  if [[ -n "${url}" ]]; then save logo "${url}"; else echo "no custom logo is set: resources/defaults/ keeps the logo it has, if any"; fi
  code=$(fetch /__coder-ui/boot.js "${WORK}/boot.js")
  [[ "${code}" == 200 ]] || die "${CODER_URL}/__coder-ui/boot.js answered HTTP ${code}"
  avatars=$(sed -n 's/.*window\.__cuiAvatars=\({[^;]*}\);.*/\1/p' "${WORK}/boot.js" | head -n1)
  users=$(jq -r 'keys[]' <<<"${avatars:-"{}"}")
  if [[ -n "${AVATAR_USER:-}" ]]; then
   url=$(jq -r --arg u "${AVATAR_USER}" '.[$u] // empty' <<<"${avatars:-"{}"}")
   [[ -n "${url}" ]] || die "${AVATAR_USER} has no uploaded avatar (users who have one: $(tr '\n' ' ' <<<"${users}"))"
   save avatar "${url}"
  elif [[ -z "${users}" ]]; then
   echo "no user has uploaded an avatar: resources/defaults/ keeps the avatar it has, if any"
  elif [[ $(wc -l <<<"${users}") -eq 1 ]]; then
   save avatar "$(jq -r --arg u "${users}" '.[$u]' <<<"${avatars}")"
  else
   die "several users have an avatar; pick one: ./coder-ui-updates export-defaults <username>
(or AVATAR_USER=<username> ./coder-ui-updates export-defaults, on one line, or export AVATAR_USER first):
$(sed 's/^/  /' <<<"${users}")"
  fi
  cat <<MSG

Next: ../coder-platform/build-bundle ships resources/defaults/ (the installer makes the ConfigMaps), and
./coder-ui-updates apply installs them in this cluster too: users without a picture show the default avatar; the
default logo is only used by an installation whose database has no logo table yet (a fresh one).
MSG
  ;;

 -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
 *) die "unknown action '${ACTION}' (apply | verify | remove | render | export-defaults)" ;;
esac
