#!/bin/bash
# Tailors the Coder dashboard (open-source Coder, served through Traefik's Gateway API) without rebuilding Coder:
#
#   user menu        removes the support links "Documentation", "Star the repo", "Join the Coder Discord" and
#                    "Report a bug"; a "Dark Mode" switch takes Documentation's place (Light default <-> Dark default)
#   navbar           "Workspaces" is a drop-down (the auto-dev-server icon, built like the Admin menu): "Workspace"
#                    (the workspaces list) and "Templates"; "Agents" moves to General > AI > Agents (Coder Agents
#                    embedded in the General page)
#   user menu        "Avatar": each user uploads a picture, kept in Coder's database (coder_ui_updates.avatar) and
#                    shown wherever Coder shows their avatar (user menu, workspace lists), a circle in a rounded square
#   Admin menu       called "Admin" (was "Admin settings"); "Deployment" is called "Settings" (it opens General),
#                    "Healthcheck" is called "Health"; adds "Accounts" (Coder's users page, also General > Accounts;
#                    its heading, tab title and "Create account" say so too) for admins
#                    who may list users; "AI" moves into General's sidebar
#   Health           a "Workspace Health" panel entry (blue check / alert) and page listing failed or unhealthy
#                    workspaces; a row opens the workspace
#   General          (Deployment) sidebar in alphabetical order; removes "Licenses", "Workspace Proxies", "Groups",
#                    "IdP Organization Sync", "Premium"; Security loses "Browser-Only Connections", Observability loses
#                    "Audit Logging":
#     Announcement   ("Appearance" repurposed) the Banner admin page (coder-banner, /__banner/admin) inside the dashboard:
#                    visibility switch + orange "Show again to everyone" at the top, colour swatches / custom colours,
#                    Markdown with preview, emoji picker and a live countdown under the message, and Acknowledgements
#                    (per announcement: who saw it, who confirmed it, who has not; each record can be deleted)
#     Classification a marking bar glued to the very top and very bottom of every Coder page: text, height, colours
#     Keycloak       ("External Authentication" repurposed) discovers Keycloak and Coder's OIDC set-up, checks every
#                    piece (client, callback, scopes, secret, CA, Coder's settings, users) and fixes what is wrong on
#                    approval: Keycloak's admin API, the two Secrets Coder reads, Coder's Argo CD Helm values
#     Customize      upload a logo that replaces every Coder logo (and the tab icon); kept in Coder's own
#                    CloudNativePG database (schema coder_ui_updates). Below it, Coder's own Appearance settings
#                    (theme, terminal font), moved here from Settings > Appearance
#     Network        starts with a live cluster map: nodes (addresses, pod CIDR, CPU / memory, pods), Coder's pods and
#                    the workspaces on each node, agent connections; refreshed every 5 seconds
#     Monitoring     every user with their running workspaces; a live, streamed log per workspace (the pod's log,
#                    buffered in a temporary PostgreSQL, 5 MB per workspace)
#   the banner       Markdown, countdown and custom colours; its "×" becomes "Confirm", recorded per Coder user;
#                    docked in the (sticky) navbar as a rounded card, so it stays in view while the page scrolls
#   user menu        no "Codernauts" / "Banner" item (the banner lives in General > Announcement)
#   Settings         "Certificates": each user uploads their PKCS#12 (.p12/.pfx) file; workspaces started from templates
#                    that include resources/workspace-certificates.tf get it as ~/.cert/<username>.p12 (mode 0600)
#   Workspace page   every agent gets a "Terminal" drop-down under its "Logs": the agent's terminal (Coder's own
#                    terminal page, framed) inside the page, no new window. "End session when closed" (on by default)
#                    ends the shell when the drop-down is collapsed or the page is left; an "End session" button too
#   Chat             Admin > Users: a "Chat" button on each user (admins only) opens a Gmail-style window at the bottom
#                    right, resting on the footer (deployment stats bar, classification marking: measured, so it moves
#                    with them); the user gets it on whatever Coder page they have open and answers there. Admins'
#                    messages on the left in sky blue, developers' on the right. Typing indicator, minimize / close, a
#                    "Chats" panel sliding up from its handle to reopen conversations, unread counts on the window, the
#                    handle and the navbar's inbox bell. Admins may start conversations, others answer; messages are
#                    kept 30 days in the service's SQLite volume. Windows sit above the panel, resizable from their top
#                    edge (kept within the free height); their ⋮ menu takes a screenshot of the page (minus the chat)
#                    into the message, or deletes the conversation for both people. Non-admins always have the panel:
#                    their line to the admins (listed there), whom they may write to first
#   Admin > Accounts a click on a user's row opens their workspace (their list when they have none or several)
#   Admin menu       ends with the cluster's CPU and memory: two live bars (in use, reserved, free to give)
#   Settings         "Account" starts with your avatar, large, with a pencil badge: click it to change the picture
#   Chat window      a tiny lock in its top-right corner: the chat travels over HTTPS (TLS)
#   Default images   resources/defaults/logo.<ext> and avatar.<ext> (export-defaults saves what this Coder shows now):
#                    a fresh installation starts with that logo; every user without a picture of their own shows that
#                    avatar. Each goes into its own ConfigMap (coder-ui-updates-default-logo / -avatar, 1 MB at most)
#
# How: Coder's dashboard is client-rendered, so these items only exist in its JavaScript. An HTTPRoute of its own sends
# the two chunks that render them through Traefik's rewrite-body plugin (the same response-body writer and middleware
# pattern the coder-banner chart uses). A small standard-library Python service under /__coder-ui/ serves the add-on
# scripts and keeps the announcement receipts in SQLite on a PersistentVolumeClaim.
# Nothing of Coder's, the banner's, Traefik's or Argo CD's is modified; everything created here carries the label
# app.kubernetes.io/managed-by=coder-ui-updates and `remove` deletes exactly that.
#
# Usage:  ./coder-ui-updates [apply|verify|remove|render|export-defaults [<username>]]
#   apply   (default) create or update everything, then verify it through the Gateway (rolls the route back if
#           Coder's entry chunk stops loading)
#   verify  check each change in the JavaScript that browsers actually get; run it after every Coder upgrade
#   remove  delete everything this created except the receipts volume and the logo; Coder's stock menus come back
#           (remove --purge also deletes the receipts and drops the logo schema from Coder's database)
#   render  print the manifests that apply would send, change nothing
#   export-defaults   save the logo and an avatar this Coder shows now as resources/defaults/ (through the Gateway,
#           like a browser; changes nothing in the cluster). <username> (or AVATAR_USER) picks the avatar when several
#           users uploaded one. ../coder-platform/build-bundle ships them; its installer makes the ConfigMaps
#
# Environment (all optional; the defaults are read from the cluster):
#   CODER_NAMESPACE     namespace of Coder                                     [coder]
#   CODER_SERVICE       Coder's Service                                        [coder]
#   CODER_ROUTE         Coder's own HTTPRoute (Gateway and listener are copied) [coder]
#   CODER_URL           https://<coder host>             [the Deployment's CODER_ACCESS_URL]
#   CODER_CA_FILE       CA (PEM) that signed Coder's certificate  [else Secret $CODER_CA_SECRET (tls-ca), key ca.crt]
#   CODER_ADDRESS       IP or host name to connect to for https://<coder host> (verify before DNS points there)  [DNS]
#   TRAEFIK_NAMESPACE   where Traefik runs, to find the rewrite-body plugin    [traefik]
#   PLUGIN_NAME         name of the rewrite-body plugin in Traefik's static config [detected from Traefik's arguments]
#   IMAGE               Python 3.8+ image for the service  [coder-banner's image, else docker.io/library/python:3.13-alpine]
#   KEYCLOAK_NAMESPACE  namespace of the Keycloak resource (operator)     [found in the cluster; empty = none]
#   KEYCLOAK_ADMIN_SECRET  the operator's admin Secret there              [<keycloak name>-initial-admin]
#   ARGOCD_NAMESPACE / ARGOCD_APP  the Argo CD Application managing Coder [argocd / from Coder's tracking annotation]
#   CODER_DB_CLUSTER    Coder's CloudNativePG Cluster (logo storage)      [the Cluster whose app Secret Coder uses]
#   WORKSPACE_NAMESPACE where Coder creates workspace pods (Monitoring)   [the Coder namespace]
#   LOGS_DB_IMAGE       PostgreSQL image for the temporary log database   [the image Coder's database runs]
#   BANNER_SERVICE      coder-banner's Service (receipts only accept the live announcement) [coder-banner]
#   ADMIN_ROLES         Coder roles that may see the receipts  [coder-banner's ADMIN_ROLES, else owner]
#   STORAGE_CLASS       StorageClass of the receipts volume                    [the cluster default]
#   HIDE_SUPPORT_LINKS  support-link names to remove, "|"-separated, case-insensitive
#                                                  [Documentation|Star the repo|Join the Coder Discord|Report a bug]
#   VIEW_LABEL          sidebar label of the repurposed Appearance item        [Announcement]
#   VIEW_PATH           its URL: /deployment/<VIEW_PATH>                        [announcement]
#
# Resources (rendered from ./resources, @@PLACEHOLDERS@@ filled in here):
#   middlewares.yaml         the rewrite-body regexes and middleware chains
#   httproute.yaml           the route for the two chunks and /__coder-ui/ (and why it wins over the banner's)
#   ui-service.yaml          data volume, service Deployment + Service; ConfigMap built from the files below
#   rbac*.yaml               ServiceAccount + Roles (Coder / workspaces / Keycloak / Argo CD namespaces) and a read-only
#                            ClusterRole (nodes, pods, node metrics) for the Network map
#   logs-db.yaml             the temporary log database (PostgreSQL on an emptyDir) for Monitoring
#   httproute-native.yaml    the route for Coder's platform build (add-ons built in): only /__coder-ui/, no rewrites
#   pgwire.py                the service's PostgreSQL client (pure Python)
#   certinfo.py              certificate / key / TLS-endpoint inspection for Security (pure Python)
#   ui-service.py            serves /__coder-ui/: the files below, the receipts / classification / Keycloak APIs,
#                            /__coder-ui/refresh (clears a browser's cached Coder JavaScript)
#   dashboard.js             on every Coder page: loads classification.js, ack.js and banner-dock.js
#   classification.js        the top / bottom classification bars
#   ack.js                   the announcement: Markdown, countdown, colours, Confirm; reports seen / confirmed
#   banner-enhance.js        how the announcement is drawn (shared by ack.js and the admin page's previews)
#   banner-dock.js           puts the announcement in the navbar's right-hand group instead of under the navbar
#   views.js                 mounts the Deployment views (Announcement, Classification, Keycloak) in Coder's layout
#   admin-embed.js, announcement-embed.css   rearrange and restyle the embedded Banner admin page
#   view.css, classification.*, keycloak.*, logo.*, monitoring.*   the General views
#   workspace-health*        Health > Workspace Health (panel icon and page)
#   certificates*, pkcs12.js Settings > Certificates (each user's .p12 file, kept as their own Coder secret)
#   network.*                General > Network: the live cluster map
#   theme-toggle.js          the user menu's Dark Mode switch
#   avatar.*                 User menu > Avatar: upload your own picture (kept in Coder's database)
#   agent-terminal.*         Workspace page > agent > Terminal: the framed terminal and its session (start / end)
#   chat.*                   the chat windows on every page (Admin > Users > Chat starts a conversation)
#   users-row.js             Admin > Users: a click on a row opens that user's workspace (or their workspaces list)
#   html2canvas.min.js       html2canvas 1.4.1 (MIT, third party, unmodified from npm): draws the chat's screenshots
#   cluster-gauge.js         Admin menu: the cluster's CPU and memory, two live bars (dashboard.css)
#   account-avatar.js        Settings > Account: your avatar above Email, click to change it (avatar.css)
#   workspaces-icon.png      the navbar's Workspaces drop-down icon: windows.png (the source, not served) at 40 px, twice
#                            its 20 px size for sharp HiDPI screens (small on purpose: the ConfigMap and Helm's release
#                            record have little room for images)
#   defaults/                logo.<ext>, avatar.<ext> (PNG, JPEG, GIF, WebP; the logo may be SVG): the default images
#   workspace-certificates.tf  add to a workspace template: installs it as ~/.cert/<username>.p12
set -euo pipefail
cd "$(dirname "$0")"
RES=./resources

ACTION="${1:-apply}"
NS="${CODER_NAMESPACE:-coder}"
CODER_SERVICE="${CODER_SERVICE:-coder}"
CODER_ROUTE="${CODER_ROUTE:-coder}"
TRAEFIK_NS="${TRAEFIK_NAMESPACE:-traefik}"
BANNER_SERVICE="${BANNER_SERVICE:-coder-banner}"
HIDE_SUPPORT_LINKS="${HIDE_SUPPORT_LINKS-Documentation|Star the repo|Join the Coder Discord|Report a bug}"
VIEW_LABEL="${VIEW_LABEL:-Announcement}"
VIEW_PATH="${VIEW_PATH:-announcement}"
MANAGED=app.kubernetes.io/managed-by=coder-ui-updates
STATIC_FILES=(dashboard.js dashboard.css classification.js ack.js banner-enhance.js banner-dock.js views.js admin-embed.js announcement-embed.css
 view.css classification.html classification.css classification-view.js keycloak.html keycloak.css keycloak-view.js
 logo.html logo.css logo-view.js monitoring.html monitoring.css monitoring-view.js
 workspace-health.js workspace-health.html workspace-health.css workspace-health-view.js
 pkcs12.js certificates.html certificates.css certificates-view.js network.html network.css network-view.js
 theme-toggle.js avatar.js avatar.css agent-terminal.js agent-terminal.css chat.js chat.css users-row.js html2canvas.min.js
 cluster-gauge.js account-avatar.js workspaces-icon.png)   # served under /__coder-ui/
DEFAULT_MAX_BYTES=1048576   # per default image: a ConfigMap holds 1 MiB of data at most, the service takes up to that too
CA_SOURCE_SECRET="${CODER_CA_SECRET:-tls-ca}"
ARGOCD_NAMESPACE="${ARGOCD_NAMESPACE:-argocd}"
LABELS='{app.kubernetes.io/name: coder-ui-updates, app.kubernetes.io/part-of: coder, app.kubernetes.io/managed-by: coder-ui-updates}'
BANNER_INJECT=coder-banner-inject      # the coder-banner chart's page-load middleware: its presence = the banner is installed
WORK=$(mktemp -d)
trap 'rm -rf "${WORK}"' EXIT

die() { echo "error: $*" >&2; exit 1; }
k() { kubectl -n "${NS}" "$@"; }

# ---------------------------------------------------------------- settings read from the cluster
coder_url() {
 if [[ -n "${CODER_URL:-}" ]]; then echo "${CODER_URL%/}"; return; fi
 local url
 url=$(k get deployment "${CODER_SERVICE}" -o jsonpath="{.spec.template.spec.containers[0].env[?(@.name=='CODER_ACCESS_URL')].value}" 2>/dev/null || true)
 # The coder-platform chart passes Coder's settings through a ConfigMap (envFrom).
 [[ -n "${url}" ]] || url=$(k get configmap coder-platform-config -o jsonpath='{.data.CODER_ACCESS_URL}' 2>/dev/null || true)
 echo "${url%/}"
}

ca_opts() {   # sets CA_OPTS: how curl trusts Coder's certificate (same rules as ../banner-update/coder-ca.sh)
 CA_OPTS=()
 if [[ -n "${CODER_CA_FILE:-}" ]]; then
  [[ -r "${CODER_CA_FILE}" ]] || die "CODER_CA_FILE ${CODER_CA_FILE} is not readable"
  CA_OPTS=(--cacert "${CODER_CA_FILE}")
 elif k get secret "${CODER_CA_SECRET:-tls-ca}" -o jsonpath='{.data.ca\.crt}' 2>/dev/null | base64 -d >"${WORK}/ca.crt" 2>/dev/null && [[ -s "${WORK}/ca.crt" ]]; then
  CA_OPTS=(--cacert "${WORK}/ca.crt")
 fi
 # CODER_ADDRESS: connect to this IP instead of what DNS says (checking an installation before DNS points at it).
 if [[ -n "${CODER_ADDRESS:-}" ]]; then
  local h=${CODER_URL#*://}; h=${h%%/*}; h=${h%%:*}
  CA_OPTS+=(--connect-to "${h}:443:${CODER_ADDRESS}:443")   # an IP or a host name (e.g. an AWS load balancer)
 fi
}

# The rewrite-body plugin's name in Traefik's static configuration, from the running Traefik's arguments.
detect_plugin() {
 if [[ -n "${PLUGIN_NAME:-}" ]]; then echo "${PLUGIN_NAME}"; return; fi
 local args
 args=$(kubectl -n "${TRAEFIK_NS}" get deployments -o jsonpath='{range .items[*].spec.template.spec.containers[*]}{range .args[*]}{@}{"\n"}{end}{end}' 2>/dev/null || true)
 sed -nE '/^--experimental\.(localPlugins|plugins)\.[^.=]+\.moduleName=.*rewrite-?body/I{s/^--experimental\.[A-Za-z]+\.([^.=]+)\..*$/\1/p;q}' <<<"${args}"
}

validate_settings() {
 [[ "${VIEW_LABEL}" =~ ^[A-Za-z0-9\ _-]{1,30}$ ]] || die "VIEW_LABEL may only contain letters, digits, spaces, '_' and '-' (max 30)"
 [[ "${VIEW_PATH}" =~ ^[a-z0-9-]{1,40}$ ]] || die "VIEW_PATH may only contain lower-case letters, digits and '-'"
 case "${VIEW_PATH}" in   # Coder's own /deployment/* pages (v2.36); reusing one would shadow it
  overview|licenses|userauth|external-auth|oauth2-provider|network|workspace-proxies|security|observability|users|groups|idp-org-sync|notifications|premium|classification|keycloak|customize|monitoring|agents)
   die "VIEW_PATH '${VIEW_PATH}' is one of Coder's own Deployment pages: pick another" ;;
 esac
 local name
 IFS='|' read -r -a names <<<"${HIDE_SUPPORT_LINKS}"
 for name in "${names[@]}"; do
  [[ -z "${name// }" || "${name}" =~ ^[A-Za-z0-9\ ._-]+$ ]] || die "HIDE_SUPPORT_LINKS entry '${name}': only letters, digits, spaces, '.', '_' and '-'"
 done
}

# The platform build of Coder (the fork, image .../coder-platform) has every add-on built into its dashboard: the
# rewrites would add each one a second time. Then only /__coder-ui/ is routed, and Coder's pages and JavaScript are
# served unchanged (httproute-native.yaml). NATIVE_DASHBOARD=auto|true|false.
detect_native() {
 local coder_image
 coder_image=$(k get deployment "${CODER_SERVICE}" -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || true)
 case "${NATIVE_DASHBOARD:-auto}" in
  auto) if [[ "${coder_image}" == *coder-platform* ]]; then NATIVE=1; else NATIVE=0; fi ;;
  true|1) NATIVE=1 ;;
  false|0) NATIVE=0 ;;
  *) die "NATIVE_DASHBOARD must be auto, true or false" ;;
 esac
}

gather() {
 command -v kubectl >/dev/null || die "kubectl is required"
 command -v jq >/dev/null || die "jq is required"
 validate_settings
 k get deployment "${CODER_SERVICE}" >/dev/null 2>&1 || die "no Deployment '${CODER_SERVICE}' in namespace ${NS} (set CODER_NAMESPACE / CODER_SERVICE)"
 CODER_PORT=$(k get service "${CODER_SERVICE}" -o jsonpath='{.spec.ports[0].port}') || die "no Service '${CODER_SERVICE}' in ${NS}"
 CODER_URL=$(coder_url); [[ -n "${CODER_URL}" ]] || die "could not read CODER_ACCESS_URL from the Coder Deployment (set CODER_URL)"
 HOST=${CODER_URL#*://}; HOST=${HOST%%/*}; HOST=${HOST%%:*}

 local route
 route=$(k get httproute "${CODER_ROUTE}" -o json 2>/dev/null) || die "Coder's HTTPRoute '${CODER_ROUTE}' not found in ${NS} (set CODER_ROUTE)"
 GATEWAY_NAME=$(jq -r '.spec.parentRefs[0].name' <<<"${route}")
 GATEWAY_NS=$(jq -r --arg ns "${NS}" '.spec.parentRefs[0].namespace // $ns' <<<"${route}")
 SECTION_NAME=$(jq -r '.spec.parentRefs[0].sectionName // empty' <<<"${route}")

 detect_native

 PLUGIN=$(detect_plugin)
 [[ ${NATIVE} -eq 1 && -z "${PLUGIN}" ]] && PLUGIN=rewrite-body   # not used: nothing is rewritten
 [[ -n "${PLUGIN}" ]] || die "Traefik (namespace ${TRAEFIK_NS}) has no rewrite-body plugin enabled. Enable it first:
  ../banner-update/traefik-plugin/enable-plugin --airgap
 (or set PLUGIN_NAME if Traefik is configured from a file)"
 [[ "${PLUGIN}" =~ ^[A-Za-z0-9_-]+$ ]] || die "unexpected plugin name '${PLUGIN}'"

 if k get middleware "${BANNER_INJECT}" >/dev/null 2>&1; then BANNER_PRESENT=1; else BANNER_PRESENT=0; fi
 # Same image and admin roles as the banner service (its image is already on the nodes / in the local registry).
 local banner_image banner_roles banner_port
 banner_image=$(k get deployment "${BANNER_SERVICE}" -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || true)
 banner_roles=$(k get deployment "${BANNER_SERVICE}" -o jsonpath="{.spec.template.spec.containers[0].env[?(@.name=='ADMIN_ROLES')].value}" 2>/dev/null || true)
 IMAGE="${IMAGE:-${banner_image:-docker.io/library/python:3.13-alpine}}"
 ADMIN_ROLES="${ADMIN_ROLES:-${banner_roles:-owner}}"
 [[ "${ADMIN_ROLES}" =~ ^[A-Za-z0-9_,-]+$ ]] || die "ADMIN_ROLES must be comma-separated role names"
 banner_port=$(k get service "${BANNER_SERVICE}" -o jsonpath='{.spec.ports[?(@.name=="http")].port}' 2>/dev/null || true)
 BANNER_URL="http://${BANNER_SERVICE}.${NS}.svc.cluster.local:${banner_port:-80}"
 [[ -z "${STORAGE_CLASS:-}" || "${STORAGE_CLASS}" =~ ^[a-z0-9.-]+$ ]] || die "STORAGE_CLASS '${STORAGE_CLASS}' is not a valid name"

 # Keycloak (operator resource) and the Argo CD Application that manages Coder, for the Keycloak view.
 local kc_line tracking
 if [[ -z "${KEYCLOAK_NAMESPACE+x}" ]]; then
  kc_line=$(kubectl get keycloaks.k8s.keycloak.org -A -o jsonpath='{range .items[*]}{.metadata.namespace} {.metadata.name}{"\n"}{end}' 2>/dev/null || true)
  kc_line=${kc_line%%$'\n'*}
  KEYCLOAK_NAMESPACE=${kc_line%% *}
  [[ -n "${kc_line}" ]] && KEYCLOAK_ADMIN_SECRET="${KEYCLOAK_ADMIN_SECRET:-${kc_line##* }-initial-admin}"
 fi
 KEYCLOAK_ADMIN_SECRET="${KEYCLOAK_ADMIN_SECRET:-keycloak-initial-admin}"
 if [[ -z "${ARGOCD_APP+x}" ]]; then
  tracking=$(k get deployment "${CODER_SERVICE}" -o jsonpath='{.metadata.annotations.argocd\.argoproj\.io/tracking-id}' 2>/dev/null || true)
  ARGOCD_APP=${tracking%%:*}
  [[ -n "${ARGOCD_APP}" ]] && ! kubectl -n "${ARGOCD_NAMESPACE}" get application "${ARGOCD_APP}" >/dev/null 2>&1 && ARGOCD_APP=""
 fi
 for v in KEYCLOAK_NAMESPACE KEYCLOAK_ADMIN_SECRET ARGOCD_APP ARGOCD_NAMESPACE CA_SOURCE_SECRET; do
  [[ -z "${!v}" || "${!v}" =~ ^[a-z0-9.-]+$ ]] || die "${v} '${!v}' is not a valid name"
 done
 # Coder's CloudNativePG database (logo) and the PostgreSQL image it runs (temporary log database).
 local db_secret
 db_secret=$(k get deployment "${CODER_SERVICE}" -o jsonpath="{.spec.template.spec.containers[0].env[?(@.name=='CODER_PG_CONNECTION_URL')].valueFrom.secretKeyRef.name}" 2>/dev/null || true)
 # the Secret Coder reads its OIDC client secret from (the Keycloak view compares and repairs that one)
 OIDC_SECRET_NAME=$(k get deployment "${CODER_SERVICE}" -o jsonpath="{.spec.template.spec.containers[0].env[?(@.name=='CODER_OIDC_CLIENT_SECRET')].valueFrom.secretKeyRef.name}" 2>/dev/null || true)
 OIDC_SECRET_NAME="${OIDC_SECRET_NAME:-keycloaking-coder-oidc}"
 CODER_DB_CLUSTER="${CODER_DB_CLUSTER:-${db_secret%-app}}"
 CODER_DB_SECRET="${CODER_DB_SECRET:-${db_secret:-${CODER_DB_CLUSTER}-app}}"
 CODER_DB_CA_SECRET="${CODER_DB_CA_SECRET:-${CODER_DB_CLUSTER}-ca}"
 if [[ -z "${LOGS_DB_IMAGE:-}" ]]; then
  LOGS_DB_IMAGE=$(k get pods -l "cnpg.io/cluster=${CODER_DB_CLUSTER}" -o jsonpath='{.items[0].spec.containers[0].image}' 2>/dev/null || true)
 fi
 LOGS_DB_IMAGE="${LOGS_DB_IMAGE:-ghcr.io/cloudnative-pg/postgresql:17}"
 WORKSPACE_NAMESPACE="${WORKSPACE_NAMESPACE:-${NS}}"
 # Security > certificates: the Secrets Coder mounts (always including the CA Secret, so the list is never empty)
 CODER_CERT_SECRETS=$( { echo "${CA_SOURCE_SECRET}"; k get deployment "${CODER_SERVICE}" -o jsonpath='{range .spec.template.spec.volumes[*]}{.secret.secretName}{"\n"}{range .projected.sources[*]}{.secret.name}{"\n"}{end}{end}' 2>/dev/null; } \
  | grep -E '^[a-z0-9.-]+$' | sort -u | sed 's/.*/"&"/' | paste -sd, -)
 for v in CODER_DB_CLUSTER CODER_DB_SECRET CODER_DB_CA_SECRET WORKSPACE_NAMESPACE; do
  [[ -z "${!v}" || "${!v}" =~ ^[a-z0-9.-]+$ ]] || die "${v} '${!v}' is not a valid name"
 done
 [[ "${LOGS_DB_IMAGE}" =~ ^[A-Za-z0-9./:@_-]+$ ]] || die "LOGS_DB_IMAGE '${LOGS_DB_IMAGE}' is not a valid image reference"
 HIDDEN_JSON=$(jq -cn --arg s "${HIDE_SUPPORT_LINKS}" '$s | split("|") | map(ascii_downcase | gsub("^ +| +$"; "")) | map(select(length > 0))')
}

# ---------------------------------------------------------------- rendering
render_file() {
 local banner_line='' section_line='' storage_line=''
 # The banner's own loader, added to page loads by this route now that it serves them (only when the banner is installed).
 [[ ${BANNER_PRESENT} -eq 1 ]] && banner_line="        - regex: '</head>'\n          replacement: '<script src=\"/__banner/banner.js\" defer></script></head>'"
