#!/bin/sh
# Obsidian in an Obsidian workspace, at every start (the template's startup script runs it in the background): the
# vault (VAULT, made if missing) registered in Obsidian's settings as the one it opens, its automatic updates off (no
# internet: the image is its version), then the app on the workspace's desktop (display :1). Safe to run again (an
# Obsidian already running is kept).
#   coder-obsidian-start [VAULT]       default ~/Obsidian
set -u
VAULT="${1:-$HOME/Obsidian}"
mkdir -p "$VAULT/.obsidian"
if [ ! -e "$VAULT/Welcome.md" ] && [ -z "$(find "$VAULT" -mindepth 1 -maxdepth 1 ! -name .obsidian 2>/dev/null | head -n 1)" ]; then
	printf '# Welcome\n\nThis vault is a folder of your workspace: %s.\nIts notes are Markdown files, kept with the workspace.\n' "$VAULT" >"$VAULT/Welcome.md"
fi
python3 - "$HOME/.config/obsidian/obsidian.json" "$VAULT" <<'PY'
import hashlib, json, os, sys, time
path, vault = sys.argv[1], os.path.realpath(sys.argv[2])
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    cfg = json.load(open(path))
except Exception:
    cfg = {}
vaults = cfg.setdefault("vaults", {})
vid = next((k for k, v in vaults.items() if os.path.realpath(v.get("path", "")) == vault),
           hashlib.sha256(vault.encode()).hexdigest()[:16])
for k, v in vaults.items():
    v.pop("open", None)
vaults[vid] = {**vaults.get(vid, {}), "path": vault, "ts": int(time.time() * 1000), "open": True}
cfg["updateDisabled"] = True
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f)
os.replace(tmp, path)
PY
export DISPLAY="${DISPLAY:-:1}" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
if pgrep -u "$(id -u)" -x obsidian >/dev/null; then
	echo "Obsidian: running already"
	exit 0
fi
if [ ! -S "/tmp/.X11-unix/X${DISPLAY#:}" ]; then
	echo "Obsidian: no desktop on display $DISPLAY: not started"
	exit 1
fi
(cd "$HOME" && setsid /usr/local/bin/obsidian-app </dev/null >/tmp/obsidian.log 2>&1 &)
echo "Obsidian: started on the desktop with the vault $VAULT (log: /tmp/obsidian.log)"
